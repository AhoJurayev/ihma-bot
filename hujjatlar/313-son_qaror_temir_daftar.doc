ont-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body style='tab-interval:.5in'>
<div class=Section1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6973951">[<b>OKOZ:</b><div id="LBC9109"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish]</span></div></a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5988"></label><a id="onLS-6973951">[<b>TSZ:</b><div id="LS3698"><span class="iorRN">1.</span><span class="iorVal">Ijtimoiy-madaniy masalalar / Ijtimoiy sug‘urta, ijtimoiy ta’minot va ijtimoiy himoya]</span></div></a></div><div class="ACCEPTING_BODY"><a id="-6974186">O‘zbekiston Respublikasi Vazirlar Mahkamasining</a></div><div class="ACT_FORM"><a id="-6974187">qarori</a></div><div class="ACT_TITLE"><a id="-6974188">“Temir daftar” orqali ijtimoiy xizmat va yordam ko‘rsatish hamda “Saxovat va ko‘mak” jamg‘armasi mablag‘larini shakllantirish va ulardan foydalanish tartibini takomillashtirish to‘g‘risida</a></div><div class="BY_DEFAULT"><a id="-6974190"></a></div><div class="ACT_TEXT"><a id="-6974191">O‘zbekiston Respublikasi Prezidentining “<a href="http://lex.uz/docs/-6705763">Mahalla institutining jamiyatdagi rolini tubdan oshirish va uning aholi muammolarini hal etishda birinchi bo‘g‘in sifatida ishlashini ta’minlashga qaratilgan chora-tadbirlar to‘g‘risida</a>” 2023-yil 21-dekabrdagi PF-209-son Farmoni hamda “<a href="http://lex.uz/docs/-6705734">O‘zbekiston mahallalari uyushmasi faoliyatini yo‘lga qo‘yish va mahallalarda boshqaruv tizimini takomillashtirishga oid qo‘shimcha chora-tadbirlar to‘g‘risida</a>” 2023-yil 21-dekabrdagi PQ-402-son qaroriga muvofiq Vazirlar Mahkamasi qaror qiladi:</a></div><div class="ACT_TEXT"><a id="-6974317">1. O‘zbekiston Respublikasi Prezidentining “Mahalla institutining jamiyatdagi rolini tubdan oshirish va uning aholi muammolarini hal etishda birinchi bo‘g‘in sifatida ishlashini ta’minlashga qaratilgan chora-tadbirlar to‘g‘risida” 2023-yil 21-dekabrdagi PF-209-son <a href="http://lex.uz/docs/-6705763">Farmoniga</a> muvofiq 2024-yil 1-martdan boshlab:</a></div><div class="ACT_TEXT"><a id="-6974318">jismoniy shaxslarni “Temir daftar”, “Yoshlar daftari” va “Ayollar daftari”ga kiritish, shuningdek, ushbu daftarlar hamda Aholini tadbirkorlikka jalb qilish jamg‘armasi, Bandlikka ko‘maklashish davlat jamg‘armasi hamda Hunarmandchilik va kasanachilikni qo‘llab-quvvatlash jamg‘armasi orqali ijtimoiy yordam ko‘rsatish va subsidiyalar ajratish “Mahalla yettiligi”ning kollegial qarori asosida amalga oshirilishi;</a></div><div class="ACT_TEXT"><a id="-6974320">har oyning 5-sanasiga qadar “Temir daftar”, “Yoshlar daftari” va “Ayollar daftari” uchun mablag‘larni taqsimlovchi mas’ul tashkilotlar tomonidan mazkur jamg‘armalarda shakllangan mablag‘lar ularga kiritilgan fuqarolar soniga mutanosib ravishda tegishliligi bo‘yicha har bir mahalla kesimida taqsimlanishi;</a></div><div class="ACT_TEXT"><a id="-6974321">“Temir daftar” O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi va uning hududiy bo‘linmalari tomonidan yuritilishi;</a></div><div class="ACT_TEXT"><a id="-6974323">“Saxovat va ko‘mak” jamg‘armasi tomonidan ko‘rsatiladigan yordamlar fuqarolarning og‘ir ijtimoiy ahvolga tushib qolishining oldini olish va shunday vaziyatga tushganlarni og‘ir vaziyatdan chiqarish maqsadida ijtimoiy xodim tomonidan “Mahalla yettiligi”ga ko‘rib chiqish uchun kiritilgan holda ko‘rsatilishi belgilanganligi ma’lumot uchun qabul qilinsin.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974324">[<b>OKOZ:</b><div id="LBC6074"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.15.00.00 Mahalliy davlat hokimiyati organlari / 01.15.01.00 Mahalliy davlat vakillik organlari (Xalq deputatlari kengashlari) / 01.15.01.02 Mahalliy vakillik organlarining vakolatlari;</span></div><div id="LBC6183"><span class="iorRN">2.</span><span class="iorVal">03.00.00.00 Fuqarolik qonunchiligi / 03.03.00.00 Yuridik shaxslar / 03.03.10.00 Notijorat tashkilotlari / 03.03.10.04 Jamoat fondlari;</span></div><div id="LBC6567"><span class="iorRN">3.</span><span class="iorVal">07.00.00.00 Moliya va kredit to‘g‘risidagi qonunchilik. Bank faoliyati / 07.08.00.00 G‘aznachilik]</span></div></a></div><div class="ACT_TEXT"><a id="-6974324">2. 2024-yil 25-iyunga qadar O‘zbekiston “Mahalla” xayriya jamoat fondi, uning Qoraqalpog‘iston Respublikasi, viloyatlar va Toshkent shahar bo‘limlari hamda tuman va shaharlar bo‘linmalari huzuridagi “Saxovat va ko‘mak” jamg‘armasi tuman (shahar) hokimliklari huzuriga o‘tkazilsin.</a></div><div class="ACT_TEXT"><a id="-6974326">Belgilansinki, amaldagi moliyalashtirish manbalarini saqlab qolgan holda, tuman (shahar) hokimliklari huzuridagi “Saxovat va ko‘mak” jamg‘armasi mablag‘lari tuman (shahar) g‘aznachilik bo‘limlarida alohida ochilgan shaxsiy g‘azna hisobvaraqlarida jamlanadi.</a></div><div class="ACT_TEXT"><a id="-6974328">3. O‘zbekiston “Mahalla” xayriya jamoat fondi, uning Qoraqalpog‘iston Respublikasi, viloyatlar va Toshkent shahar bo‘limlari ikki hafta muddatda “Saxovat va ko‘mak” jamg‘armasining maxsus hisobvaraqlaridagi qoldiq mablag‘lar tegishligicha tuman (shahar) hokimliklarining g‘aznachilik bo‘limlarida alohida ochilgan shaxsiy g‘azna hisobvaraqlariga o‘tkazilishini ta’minlasin.</a></div><div class="ACT_TEXT"><a id="-6974329">Bunda O‘zbekiston “Mahalla” xayriya jamoat fondining Qoraqalpog‘iston Respublikasi, viloyatlar va Toshkent shahar bo‘limlari huzuridagi “Saxovat va ko‘mak” jamg‘armasining qoldiq mablag‘lari tuman (shahar) hokimliklarining alohida ochilgan shaxsiy g‘azna hisobvaraqlariga ushbu tuman (shahar)da yashovchi “Ijtimoiy himoya yagona reyestri”ga kiritilgan oilalarning soniga mutanosib ravishda o‘tkaziladi.</a></div><div class="ACT_TEXT"><a id="-6974331">4. Quyidagilar:</a></div><div class="ACT_TEXT"><a id="-6974332">Ijtimoiy himoyaga muhtoj shaxslar va oilalarga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ijtimoiy yordam ko‘rsatish tartibi to‘g‘risidagi nizom <a href="javascript:scrollText(-6974363)">1-ilovaga</a> muvofiq;</a></div><div class="ACT_TEXT"><a id="-6974333">Og‘ir ijtimoiy ahvolga tushib qolgan oilalarni “Temir daftar”ga kiritish, hisobini yuritish hamda undan chiqarish tartibi to‘g‘risidagi nizom <a href="javascript:scrollText(-6974567)">2-ilovaga</a> muvofiq tasdiqlansin.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974334">[<b>OKOZ:</b><div id="LBC6117"><span class="iorRN">1.</span><span class="iorVal">02.00.00.00 Davlat boshqaruvi asoslari / 02.03.00.00 Respublika ijro etuvchi hokimiyat organlari va xo‘jalik boshqaruvi organlari / 02.03.02.00 Vazirliklar;</span></div><div id="LBC6473"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.01.00.00 Umumiy qoidalar;</span></div><div id="LBC9109"><span class="iorRN">3.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish]</span></div></a></div><div class="ACT_TEXT"><a id="-6974334">5. O‘zbekiston Respublikasi Iqtisodiyot va moliya vazirligi 2024-yil 1-iyuldan boshlab:</a></div><div class="ACT_TEXT"><a id="-6974338">O‘zbekiston Respublikasi Prezidentining “Sud hujjatlari va boshqa organlar hujjatlarini ijro etish tizimini yanada takomillashtirish chora-tadbirlari to‘g‘risida” 2020-yil 24-noyabrdagi PF-6118-son Farmonining <a href="http://lex.uz/docs/-5124086#-5126394">12-bandiga</a> muvofiq kelib tushgan mablag‘larning “Temir daftar”ga yo‘naltiriladigan qismi O‘zbekiston Respublikasi Iqtisodiyot va moliya vazirligi huzuridagi G‘aznachilik xizmati qo‘mitasida ochilgan yagona maxsus hisobvaraqda yig‘ilishini;</a></div><div class="ACT_TEXT"><a id="-6974339">yig‘ilgan mablag‘lar tuman (shahar)lardagi aholi soni, “Ijtimoiy himoya yagona reyestri”ga kiritilgan oilalar va nogironligi bo‘lgan shaxslar soni hamda “Temir daftar”da ro‘yxatga olingan oilalar soniga mutanosib ravishda tuman (shahar) “Saxovat va ko‘mak” jamg‘armasiga avtomatik ravishda taqsimlanishini ta’minlasin.</a></div><div class="ACT_TEXT"><a id="-6974340">Bunda O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi chorak boshlanishidan 10 kun avval ushbu bandda belgilangan ko‘rsatkichlardan kelib chiqqan holda, tuman va shaharlarga taqsimlanishi lozim bo‘lgan mablag‘lar ulushini foiz ko‘rinishida Iqtisodiyot va moliya vazirligiga taqdim etib boradi.</a></div><div class="ACT_TEXT"><a id="-6974341">6. Tuman (shahar) hokimliklari va “Mahalla yettiligi”:</a></div><div class="ACT_TEXT"><a id="-6974342">“Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatish masalasi faqat “Inson” ijtimoiy xizmatlar ko‘rsatish markazlarining ijtimoiy xodimlari tomonidan keys-menejment asosida o‘tkazilgan o‘rganish yakuni bo‘yicha shakllantirilgan tavsiyanoma bo‘lgan taqdirda ko‘rib chiqilishini;</a></div><div class="ACT_TEXT"><a id="-6974343">zarur hollarda “Saxovat va ko‘mak” jamg‘armasidan mahalla fuqarolar yig‘inlari uchun ajratilgan mablag‘lar hisobidan bir kun ichida ijtimoiy himoyaga muhtoj shaxslarga belgilangan tartibda yordam ko‘rsatilishini ta’minlasin.</a></div><div class="ACT_TEXT"><a id="-6974344">7. O‘zbekiston Respublikasi Prezidenti huzuridagi Statistika agentligi 2024-yil 1-iyulga qadar “Statistika” integrallashgan axborot tizimining “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi o‘rinlarda — “Ijtimoiy himoya” AT) bilan integratsiya qilinishini ta’minlasin.</a></div><div class="ACT_TEXT"><a id="-6974346">8. O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi:</a></div><div class="ACT_TEXT"><a id="-6974348">2024-yil 31-iyulga qadar “Ijtimoiy himoya” AT orqali “Temir daftar”ga kiritish va “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatish bilan bog‘liq tartib-taomillarni;</a></div><div class="ACT_TEXT"><a id="-6974349">2024-yil 1-avgustga qadar jismoniy va yuridik shaxslar tomonidan “Temir daftar”ga kiritilgan oilalarni qo‘llab-quvvatlash va ijtimoiy himoyaga muhtoj oilalarga manzilli xayriya qilinishini ta’minlash maqsadida kraudfanding tizimini joriy etsin hamda “Ijtimoiy himoya” ATda kraudfanding faoliyati bilan bog‘liq tartib-taomillarni amalga oshirish imkoniyatlarini yaratsin;</a></div><div class="ACT_TEXT"><a id="-6974350">2024-yil 1-oktabrga qadar “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ko‘rsatilayotgan ijtimoiy yordamlarni “Ijtimoiy karta” orqali moliyalashtirish tartibini joriy etish bo‘yicha Vazirlar Mahkamasiga taklif kiritsin.</a></div><div class="ACT_TEXT"><a id="-6974351">9. O‘zbekiston Respublikasi Hukumatining <a href="javascript:scrollText(-6974749)">3-ilovaga</a> muvofiq ayrim qarorlariga o‘zgartirish va qo‘shimchalar kiritilsin.</a></div><div class="ACT_TEXT"><a id="-6974353">10. O‘zbekiston Respublikasi Hukumatining <a href="javascript:scrollText(-6975133)">4-ilovaga</a> muvofiq ayrim hujjatlari o‘z kuchini yo‘qotgan deb hisoblansin.</a></div><div class="ACT_TEXT"><a id="-6974354">11. O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi manfaatdor vazirlik va idoralar bilan birgalikda o‘zlari qabul qilgan normativ-huquqiy hujjatlarni ikki oy muddatda ushbu qarorga muvofiqlashtirsin.</a></div><div class="ACT_TEXT"><a id="-6974355">12. Mazkur qarorning bajarilishini nazorat qilish O‘zbekiston Respublikasi Bosh vazirining o‘rinbosari — iqtisodiyot va moliya vaziri J.A. Qo‘chqorov zimmasiga yuklansin.</a></div><div class="SIGNATURE"><a id="-6974357">O‘zbekiston Respublikasining Bosh vaziri A. ARIPOV</a></div><div class="ACT_ESSENTIAL_ELEMENTS"><a id="-6974359">Toshkent sh.,</a></div><div class="ACT_ESSENTIAL_ELEMENTS"><a id="-6974360">2024-yil 31-may,</a></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><a id="-6974362">313-son</a></div><div class="BY_DEFAULT"><a id="-6974363"></a></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><a id="-6974364">Vazirlar Mahkamasining 2024-yil 31-maydagi 313-son <a href="javascript:scrollText()">qaroriga</a> <br />1-ILOVA </a></div><div class="ACT_TITLE_APPL"><a id="-6974365">“Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ijtimoiy yordam ko‘rsatish tartibi to‘g‘risida</a></div><div class="ACT_FORM"><a id="-6974366">NIZOM</a></div><div class="BY_DEFAULT"><a id="-6974367"></a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974368">1-bob. Umumiy qoidalar</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974369">[<b>OKOZ:</b><div id="LBC6094"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.17.00.00 Nodavlat notijorat tashkilotlari (shuningdek, 03.03.10.03ga qarang) / 01.17.10.00 Ijtimoiy jamg‘armalar;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974369">1. Mazkur Nizom ijtimoiy himoyaga muhtoj shaxslar va oilalarga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatish tartibini belgilaydi.</a></div><div class="ACT_TEXT"><a id="-6974370">2. “Saxovat va ko‘mak” jamg‘armasi tuman (shahar) hokimliklari huzurida yuridik shaxs maqomiga ega bo‘lmagan holda tashkil etiladi va uning mablag‘lari tuman (shahar) g‘aznachilik bo‘limlarida alohida ochilgan shaxsiy g‘azna hisobvaraqlarida yig‘iladi.</a></div><div class="ACT_TEXT"><a id="-6974371">3. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordamlar ko‘rsatish fuqarolarning og‘ir ijtimoiy ahvolga tushib qolishining oldini olish va shunday vaziyatga tushganlarni og‘ir ijtimoiy vaziyatdan chiqarish maqsadida yordam ko‘rsatiladi.</a></div><div class="ACT_TEXT"><a id="-6974372">4. “Saxovat va ko‘mak” jamg‘armasi mablag‘laridan ijtimoiy yordam ko‘rsatiladigan shaxslar va oilalar ularning murojaati yoki bevosita “Inson” ijtimoiy xizmatlar markazlarining ijtimoiy xodimlari tomonidan keys-menejment usulidan foydalangan holda o‘tkaziladigan o‘rganishlar natijalari bo‘yicha aniqlanadi.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974373">2-bob. “Saxovat va ko‘mak” jamg‘armasi mablag‘larini shakllantirish</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974374">[<b>OKOZ:</b><div id="LBC6094"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.17.00.00 Nodavlat notijorat tashkilotlari (shuningdek, 03.03.10.03ga qarang) / 01.17.10.00 Ijtimoiy jamg‘armalar;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi;</span></div><div id="LBC8793"><span class="iorRN">3.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.13.00.00 Homiylik;</span></div><div id="LBC6558"><span class="iorRN">4.</span><span class="iorVal">07.00.00.00 Moliya va kredit to‘g‘risidagi qonunchilik. Bank faoliyati / 07.06.00.00 Qoraqalpog‘iston Respublikasi budjeti. Mahalliy budjet]</span></div></a></div><div class="ACT_TEXT"><a id="-6974374">5. “Saxovat va ko‘mak” jamg‘armasi quyidagi manbalar hisobidan shakllantiriladi:</a></div><div class="ACT_TEXT"><a id="-6974375">Qoraqalpog‘iston Respublika Jo‘qorg‘i Kengesi, xalq deputatlari viloyatlar va Toshkent shahar Kengashlarining qaroriga asosan Qoraqalpog‘iston Respublikasi respublika budjeti, viloyatlar viloyat budjeti va Toshkent shahrining shahar budjeti qo‘shimcha manbalari hisobidan ajratiladigan mablag‘lar;</a></div><div class="ACT_TEXT"><a id="-6974376">tumanlar (shaharlar) xalq deputatlari Kengashlari qaroriga asosan tumanlar (shaharlar) budjetlarining qo‘shimcha manbalari hisobidan har chorakda ajratiladigan mablag‘lar;</a></div><div class="ACT_TEXT"><a id="-6974377">O‘zbekiston Respublikasi Prezidentining “Sud hujjatlari va boshqa organlar hujjatlarini ijro etish tizimini yanada takomillashtirish chora-tadbirlari to‘g‘risida” 2020-yil 24-noyabrdagi PF-6118-son Farmonining <a href="http://lex.uz/docs/-5124086#-5126394">12-bandiga</a> muvofiq o‘tkaziladigan mablag‘lar;</a></div><div class="ACT_TEXT"><a id="-6974378">kraudfanding mexanizmlari orqali kelib tushgan mablag‘lar;</a></div><div class="ACT_TEXT"><a id="-6974379">xorijiy (xalqaro) moliya institutlari va boshqa xorijiy donorlarning texnik ko‘maklari va grantlari;</a></div><div class="ACT_TEXT"><a id="-6974380">jismoniy va yuridik shaxslarning homiylik xayriyalari hamda qonunchilik hujjatlari bilan taqiqlanmagan boshqa manbalar.</a></div><div class="ACT_TEXT"><a id="-6974381">O‘zbekiston Respublikasi Prezidenti va Vazirlar Mahkamasining hujjatlari bilan “Saxovat va ko‘mak” jamg‘armasiga maqsadli mablag‘lar ajratilgan taqdirda, ushbu mablag‘lar faqat shu maqsadlar uchun sarflanadi.</a></div><div class="ACT_TEXT"><a id="-6974382">6. Mazkur Nizomning 5-bandi <a href="javascript:scrollText(-6974377)">to‘rtinchi xatboshisida</a> nazarda tutilgan mablag‘lar O‘zbekiston Respublikasi Iqtisodiyot va moliya vazirligi huzuridagi G‘aznachilik xizmati qo‘mitasida ochilgan maxsus hisobvaraqda jamlanadi hamda har chorakda O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi (keyingi o‘rinlarda — Agentlik) tomonidan quyidagi ko‘rsatkichlarga muvofiq taqdim etiladigan foizlarga asosan tuman (shahar) hokimliklari huzuridagi “Saxovat va ko‘mak” jamg‘armalariga avtomatik ravishda taqsimlanadi:</a></div><div class="ACT_TEXT"><a id="-6974384">25 foizi — tumanlar (shaharlar)dagi aholi soni;</a></div><div class="ACT_TEXT"><a id="-6974385">25 foizi — tumanlar (shaharlar)da yashovchi nogironligi bo‘lgan shaxslar soni;</a></div><div class="ACT_TEXT"><a id="-6974387">25 foizi — “Ijtimoiy himoya yagona reyestri”ga kiritilgan oilalar soni;</a></div><div class="ACT_TEXT"><a id="-6974388">25 foizi — “Temir daftar”ga kiritilgan oilalar soniga qarab.</a></div><div class="ACT_TEXT"><a id="-6974390">Bunda Agentlik tomonidan mazkur bandda nazarda tutilgan ma’lumotlar O‘zbekiston Respublikasi Prezidenti huzuridagi Statistika agentligining “Statistika” integrallashgan axborot tizimi va “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi o‘rinlarda — “Ijtimoiy himoya” AT)dan olinadi.</a></div><div class="ACT_TEXT"><a id="-6974392">7. Mazkur Nizomning <a href="javascript:scrollText(-6974382)">6-bandida</a> belgilangan ko‘rsatkichlar bo‘yicha ajratiladigan mablag‘lar miqdoriga O‘zbekiston Respublikasi Prezidentining 2022-yil 30-dekabrdagi PF-287-son Farmoni bilan tasdiqlangan Ixtisoslashuvi hamda kichik biznes uchun mavjud sharoitdan kelib chiqib toifalarga ajratilgan O‘zbekiston Respublikasi shahar va tumanlarining <a href="http://lex.uz/docs/-6333225#-6333422">ro‘yxatiga</a> muvofiq tuman (shahar)ning ixtisoslashuvi hamda kichik biznes uchun mavjud sharoitdan kelib chiqqan holda belgilangan toifasi bo‘yicha quyidagi tuzatish koeffitsiyentlari qo‘llaniladi:</a></div><div class="ACT_TEXT"><a id="-6974393">1-toifadagi tuman (shaharlar) uchun — 0,85;</a></div><div class="ACT_TEXT"><a id="-6974394">2-toifadagi tuman (shaharlar) uchun — 0,95;</a></div><div class="ACT_TEXT"><a id="-6974395">3-toifadagi tuman (shaharlar) uchun — 1,03;</a></div><div class="ACT_TEXT"><a id="-6974396">4-toifadagi tuman (shaharlar) uchun — 1,06;</a></div><div class="ACT_TEXT"><a id="-6974397">5-toifadagi tuman (shaharlar) uchun — 1,1.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974400">[<b>OKOZ:</b><div id="LBC6094"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.17.00.00 Nodavlat notijorat tashkilotlari (shuningdek, 03.03.10.03ga qarang) / 01.17.10.00 Ijtimoiy jamg‘armalar;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974400">8. Har oyning 5-sanasiga qadar tuman (shahar) iqtisodiyot va moliya bo‘limi hamda “Inson” ijtimoiy xizmatlar markazi tomonidan oldingi oyda “Saxovat va ko‘mak” jamg‘armasida shakllangan mablag‘larni (avvalgi oylardan o‘tuvchi qoldiqlarni inobatga olgan holda) quyidagi ko‘rsatkichlardan kelib chiqqan holda, mutanosib ravishda tumanlar (shaharlar)dagi mahalla fuqarolar yig‘inlari bo‘yicha taqsimlaydi:</a></div><div class="ACT_TEXT"><a id="-6974401">25 foizi — mahalla fuqarolar yig‘inidagi aholi soni;</a></div><div class="ACT_TEXT"><a id="-6974470">25 foizi — mahalla fuqarolar yig‘inida yashovchi nogironligi bo‘lgan shaxslar soni;</a></div><div class="ACT_TEXT"><a id="-6974474">25 foizi — mahalla fuqarolar yig‘inida yashovchi “Ijtimoiy himoya yagona reyestri”ga kiritilgan oilalar soni;</a></div><div class="ACT_TEXT"><a id="-6974477">25 foizi — mahalla fuqarolar yig‘inida yashovchi “Temir daftar”ga kiritilgan oilalar soni.</a></div><div class="ACT_TEXT"><a id="-6974480">Mazkur bandda belgilangan ko‘rsatkichlar bo‘yicha ma’lumotlar ushbu Nizomning <a href="javascript:scrollText(-6974382)">6-bandida</a> belgilangan tartibda olinadi.</a></div><div class="ACT_TEXT"><a id="-6974484">Mahalla fuqarolar yig‘inlari bo‘yicha taqsimlangan mablag‘larga doir ma’lumotlar “Ijtimoiy himoya” ATga “Inson” ijtimoiy xizmatlar markazlari tomonidan kiritib boriladi.</a></div><div class="ACT_TEXT"><a id="-6974488">9. Xalq deputatlari tuman (shahar) Kengashlari mazkur Nizomning <a href="javascript:scrollText(-6974400)">8-bandiga</a> muvofiq taqsimlanadigan mablag‘lar miqdorini tuman (shahar) iqtisodiyot va moliya bo‘limlari hamda “Inson” ijtimoiy xizmatlar markazlari tashabbusiga ko‘ra mahalla fuqarolar yig‘inlarining ijtimoiy-iqtisodiy holatidan kelib chiqib, “Saxovat va ko‘mak” jamg‘armasida shakllangan umumiy mablag‘lar doirasida kamaytirish yoki ko‘paytirish huquqiga ega.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974489">3-bob. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ko‘rsatiladigan yordamlar</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974490">[<b>OKOZ:</b><div id="LBC6533"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974490">10. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan quyidagi dasturlar bo‘yicha yordam ko‘rsatiladi:</a></div><div class="ACT_TEXT"><a id="-6974491">og‘ir va uzoq vaqt davolanish talab etiladigan kasallikka chalingan oilalarga yordam ko‘rsatish dasturi;</a></div><div class="ACT_TEXT"><a id="-6974492">birinchi darajali ehtiyojlarni qoplashga ko‘maklashish dasturi;</a></div><div class="ACT_TEXT"><a id="-6974493">uy-joy sharoitiga ega bo‘lmagan oilalarni qo‘llab-quvvatlash dasturi;</a></div><div class="ACT_TEXT"><a id="-6974494">isitish ta’minotidan uzilgan oilalarga yordam ko‘rsatish dasturi.</a></div><div class="ACT_TEXT"><a id="-6974495">11. Mazkur Nizomning <a href="javascript:scrollText(-6974490)">10-bandida</a> nazarda tutilgan dasturlar bo‘yicha qo‘yidagi yordamlar ko‘rsatiladi:</a></div><div class="ACT_TEXT"><a id="-6974496">a) og‘ir va uzoq vaqt davolanish talab etiladigan kasallikka chalingan oilalarga yordam ko‘rsatish dasturi doirasida:</a></div><div class="ACT_TEXT"><a id="-6974497">bazaviy hisoblash miqdorining (keyingi o‘rinlarda — BHM) 10 baravarigacha bo‘lgan miqdorda dori-darmon bilan ta’minlash xarajatlarini qoplash;</a></div><div class="ACT_TEXT"><a id="-6974498">BHMning 50 baravarigacha bo‘lgan miqdorda davolanish xarajatlarini (yashash va yo‘l xarajati bilan birga) qoplash.</a></div><div class="ACT_TEXT"><a id="-6974499">Bunda dori-darmon bilan ta’minlash xarajatlarini qoplash uchun bitta oilaga bir yilda ikki marta, davolanish xarajatlarini qoplash uchun esa bir yilda bir marta yordam ko‘rsatilishi mumkin. BHMning 5 baravarigacha bo‘lgan mablag‘lar ijtimoiy himoyaga muhtoj shaxsning bank plastik kartasiga o‘tkazib beriladi, qolgan holatlarda esa tegishli mablag‘lar shartnoma asosida o‘tkaziladi;</a></div><div class="ACT_TEXT"><a id="-6974500">b) birinchi darajali ehtiyojlarni qoplashga ko‘maklashish dasturi doirasida BHMning 1 baravari miqdorida oziq-ovqat, 5 baravarigacha miqdorida kiyim-kechak va boshqa eng zarur tovarlar bilan ta’minlash xarajatlarini qoplash. Bunda oziq-ovqat bilan ta’minlash xarajatlarini qoplash bir chorakda bir marta, kiyim-kechak bilan ta’minlash xarajatlarini qoplash esa bir yilda ikki marta belgilanishi mumkin hamda mablag‘lar ijtimoiy himoyaga muhtoj shaxsning bank plastik kartasiga o‘tkaziladi yoki shartnoma asosida natura ko‘rinishida beriladi;</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974501">[<b>OKOZ:</b><div id="LBC6769"><span class="iorRN">1.</span><span class="iorVal">08.00.00.00 Uy-joy qonunchiligi. Kommunal xo‘jalik / 08.02.00.00 Fuqarolarni uy-joy bilan ta’minlash. Uy-joy fondidan foydalanish / 08.02.01.00 Umumiy qoidalar]</span></div></a></div><div class="ACT_TEXT"><a id="-6974501">v) uy-joy sharoitiga ega bo‘lmagan oilalarni qo‘llab-quvvatlash dasturi doirasida:</a></div><div class="ACT_TEXT"><a id="-6974502">olti oy davomida har oyda ijara shartnomasining 50 foizi, biroq BHMning 4 baravaridan oshmagan miqdorda vaqtincha boshpana uchun xarajatlarni (ijara to‘lovini to‘liq yoki bir qismini) qoplash;</a></div><div class="ACT_TEXT"><a id="-6974503">BHMning 50 baravarigacha bo‘lgan miqdorda faqat bir marotaba uy-joyini ta’mirlash, shu jumladan, o‘zgalar parvarishiga muhtoj bo‘lgan yolg‘iz yashovchi hamda yolg‘iz keksalar va nogironligi bo‘lgan shaxslarning yashash sharoitini moslashtirish xarajatlarini qoplash. Bunda ushbu kichik bandda nazarda tutilgan mablag‘lar ijtimoiy himoyaga muhtoj shaxsning bank plastik kartasiga yoki shartnoma asosida o‘tkazib beriladi;</a></div><div class="ACT_TEXT"><a id="-6974504">g) isitish ta’minotidan uzilgan oilalarga yordam ko‘rsatish dasturi doirasida:</a></div><div class="ACT_TEXT"><a id="-6974505">bir yilda ko‘pi bilan ikki marotaba kuz-qish mavsumida (1-oktabrdan 15-martga qadar) BHMning 1 baravarigacha bo‘lgan miqdorda kommunal xarajatlarni qoplash;</a></div><div class="ACT_TEXT"><a id="-6974506">kuz-qish mavsumida BHMning 2 baravarigacha bo‘lgan miqdorda ko‘mir bilan ta’minlash xarajatlarini qoplash.</a></div><div class="ACT_TEXT"><a id="-6974507">Ushbu kichik bandda nazarda tutilgan mablag‘lar ijtimoiy himoyaga muhtoj shaxsning bank plastik kartasiga yoki ta’minot korxonalariga to‘g‘ridan-to‘g‘ri o‘tkazib beriladi.</a></div><div class="ACT_TEXT"><a id="-6974508">Mazkur bandda nazarda tutilgan mablag‘lar miqdori Qoraqalpog‘iston Respublikasi respublika budjetining, viloyatlar va Toshkent shahar mahalliy budjetining hamda tumanlar (shaharlar) budjetlarining qo‘shimcha manbalari hisobidan ko‘paytirilishi mumkin.</a></div><div class="ACT_TEXT"><a id="-6974509">12. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari O‘zbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari hamda Vazirlar Mahkamasining qarorlari, farmoyishlari va topshiriqlariga ko‘ra ushbu Nizomning <a href="javascript:scrollText(-6974495)">11-bandida</a> nazarda tutilmagan boshqa maqsadlarga ham yo‘naltirilishi mumkin.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974510">4-bob. “Saxovat va ko‘mak” jamg‘armasi mablag‘laridan foydalanish tartibi</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974511">[<b>OKOZ:</b><div id="LBC6094"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.17.00.00 Nodavlat notijorat tashkilotlari (shuningdek, 03.03.10.03ga qarang) / 01.17.10.00 Ijtimoiy jamg‘armalar;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974511">13. “Saxovat va ko‘mak” jamg‘armasi mablag‘laridan foydalanish quyidagi uch bosqichda amalga oshiriladi:</a></div><div class="ACT_TEXT"><a id="-6974512">birinchi bosqichda — ijtimoiy himoyaga muhtoj shaxs yoki oilaning ahvoli keys-menejment asosida o‘rganiladi hamda unga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatish bo‘yicha tavsiya shakllantiriladi;</a></div><div class="ACT_TEXT"><a id="-6974513">ikkinchi bosqichda — keys-menejment natijasi bo‘yicha shakllantirilgan tavsiya asosida yordam ko‘rsatish “Mahalla yettiligi” tomonidan kollegial tarzda ko‘rib chiqiladi va tegishli qaror qabul qilinadi. Bunda “Mahalla yettiligi”ning yig‘ilishlari har oyda ikki marta — oyning 15 va oxirgi sanasigacha o‘tkaziladi, kechiktirib bo‘lmaydigan hollar bundan mustasno;</a></div><div class="ACT_TEXT"><a id="-6974514">uchinchi bosqichda — “Mahalla yettiligi”ning yordam ko‘rsatish to‘g‘risidagi kollegial qarori asosida tuman (shahar) hokimligi tomonidan “Saxovat va ko‘mak” jamg‘armasi hisobidan tegishli mablag‘lar ajratiladi.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974515">[<b>OKOZ:</b><div id="LBC6533"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974515">14. Ijtimoiy xodim tomonidan birinchi bosqich doirasida ijtimoiy himoyaga muhtoj shaxs yoki oilaning ahvoli quyidagi asoslar bo‘yicha keys-menejment asosida o‘rganib chiqiladi:</a></div><div class="ACT_TEXT"><a id="-6974516">ijtimoiy himoyaga muhtoj shaxsning murojaati;</a></div><div class="ACT_TEXT"><a id="-6974517">ijtimoiy xodim tomonidan xonadonma-xonadon yurish natijasida.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974518">[<b>OKOZ:</b><div id="LBC6193"><span class="iorRN">1.</span><span class="iorVal">03.00.00.00 Fuqarolik qonunchiligi / 03.04.00.00 Fuqarolik qonunchiligi obyektlari / 03.04.03.00 Moddiy ne’matlar / 03.04.03.02 Ko‘chmas mulkka bo‘lgan huquqlarni davlat ro‘yxatiga olish;</span></div><div id="LBC6268"><span class="iorRN">2.</span><span class="iorVal">03.00.00.00 Fuqarolik qonunchiligi / 03.11.00.00 Majburiyatlarning alohida turlari / 03.11.16.00 Bank hisobvarag‘i;</span></div><div id="LBC9109"><span class="iorRN">3.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish;</span></div><div id="LBC6533"><span class="iorRN">4.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi;</span></div><div id="LBC6637"><span class="iorRN">5.</span><span class="iorVal">07.00.00.00 Moliya va kredit to‘g‘risidagi qonunchilik. Bank faoliyati / 07.13.00.00 Soliqqa oid ish yurituv;</span></div><div id="LBC6695"><span class="iorRN">6.</span><span class="iorVal">07.00.00.00 Moliya va kredit to‘g‘risidagi qonunchilik. Bank faoliyati / 07.24.00.00 Qimmatli qog‘ozlar. Qimmatli qog‘ozlar bozori / 07.24.02.00 Qimmatli qog‘ozlar bozorining umumiy qoidalari]</span></div></a></div><div class="ACT_TEXT"><a id="-6974518">15. Elektron axborot almashish tizimlari orqali quyidagi holatlar tasdiqlangandan so‘ng keys-menejment o‘tkazish natijasida ijtimoiy himoyaga muhtoj shaxsga (oilaga) “Saxovat va ko‘mak” jamg‘armasi hisobidan ushbu Nizomning <a href="javascript:scrollText(-6974495)">11-bandida</a> nazarda tutilgan yordamlarni ko‘rsatish to‘g‘risida ijtimoiy xodim tomonidan “Ijtimoiy himoya” AT orqali tavsiyanoma shakllantiriladi:</a></div><div class="ACT_TEXT"><a id="-6974519">a) o‘rganilayotgan oila “Ijtimoiy himoya yagona reyestri”da kam ta’minlangan oila sifatida ro‘yxatda turganda;</a></div><div class="ACT_TEXT"><a id="-6974520">b) mazkur bandning <a href="javascript:scrollText(-6974519)">“a” kichik bandi</a> shartlariga to‘g‘ri kelmagan holda quyidagi so‘rovlarga rad javobi kelganda:</a></div><div class="ACT_TEXT"><a id="-6974521">1) soliq organlarining ma’lumotiga ko‘ra oilaning har bir a’zosiga to‘g‘ri keladigan bir oylik o‘rtacha jami daromadi minimal iste’mol xarajatlari miqdorining 2,5 baravaridan ortiqligi;</a></div><div class="ACT_TEXT"><a id="-6974522">2) ko‘chmas mulk obyektlariga bo‘lgan huquqlarning davlat reyestrida bittadan ortiq ko‘chmas mulk va yer uchastkasi yoki bir va undan ortiq noturar joylar mavjudligi;</a></div><div class="ACT_TEXT"><a id="-6974523">3) oila a’zolarida qonunchilik hujjatlarida belgilangan tartibda o‘z nomiga rasmiylashtirilgan yoxud ishonchnomaga asosan quyidagilar mavjudligi:</a></div><div class="ACT_TEXT"><a id="-6974524">ishlab chiqarilgan muddati 12 yildan (oila a’zosi I yoki II guruh va 18 yoshgacha bolalikdan nogiron bo‘lsa, 7 yildan) oshmagan, texnik holati soz bo‘lgan yengil avtotransport vositasi;</a></div><div class="ACT_TEXT"><a id="-6974525">ishlab chiqarilgan muddati 15 yildan oshmagan, texnik holati soz bo‘lgan yuk tashuvchi avtotransport vositasi, avtobus, mikroavtobus, ekskavator, traktor, kombayn, yuk tashuvchi avtotransport vositalarining tirkamalari va yarim tirkamalari, avtokran hamda boshqa qurilish texnikasi;</a></div><div class="ACT_TEXT"><a id="-6974526">ikki va undan ortiq, texnik holati soz bo‘lgan yengil hamda yuk tashuvchi avtotransport vositalari, mikroavtobus, ekskavator, traktor, kombayn, yuk tashuvchi avtotransport vositalarining tirkamalari va yarim tirkamalari, avtokran va boshqa qurilish texnikasi;</a></div><div class="ACT_TEXT"><a id="-6974527">4) oila a’zolarining tijorat banklaridagi depozit hisobvaraqlarida murojaat qilingan oyda amalda bo‘lgan mehnatga haq to‘lash eng kam miqdorining 20 baravari va undan ortiq miqdorda mablag‘lar mavjudligi;</a></div><div class="ACT_TEXT"><a id="-6974528">5) oila a’zolarida murojaat qilingan oyda bozor qiymati mehnatga haq to‘lash eng kam miqdorining 20 baravari va undan ortiq summani tashkil etuvchi qimmatli qog‘ozlar mavjudligi;</a></div><div class="ACT_TEXT"><a id="-6974529">v) oila a’zolari “Yoshlar daftari” yoki “Ayollar daftari”ga ro‘yxatda turmasligi yoki joriy yilda ushbu daftarlar orqali moddiy yordam ko‘rsatilmaganligi.</a></div><div class="ACT_TEXT"><a id="-6974530">Tavsiyanoma bir kun ichida ko‘rib chiqish uchun “Mahalla yettiligi”ga kiritiladi.</a></div><div class="ACT_TEXT"><a id="-6974531">16. “Mahalla yettiligi” tomonidan ijtimoiy xodimning tavsiyanomasi besh kun ichida kollegial tartibda ko‘rib chiqiladi va quyidagi qarorlardan biri qabul qilinadi:</a></div><div class="ACT_TEXT"><a id="-6974532">ijtimoiy himoyaga muhtoj shaxs yoki oilaga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatish to‘g‘risida;</a></div><div class="ACT_TEXT"><a id="-6974533">tavsiyanomada ko‘rsatilgan yordam miqdori “Saxovat va ko‘mak” jamg‘armasida shakllangan mablag‘larning mahalla fuqarolar yig‘ini bo‘yicha taqsimlangan miqdoridan ortiq bo‘lgan taqdirda, ko‘rsatiladigan yordamlarning miqdorini kamaytirish yoki yordam ko‘rsatishni keyingi oyga kechiktirish haqida;</a></div><div class="ACT_TEXT"><a id="-6974534">ijtimoiy himoyaga muhtoj shaxs yoki oilaga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam ko‘rsatishni rad etish to‘g‘risida.</a></div><div class="ACT_TEXT"><a id="-6974535">“Mahalla yettiligi” tomonidan qabul qilinadigan qaror matni “Ijtimoiy himoya” ATda avtomatik shakllantiriladi. Bunda ko‘rsatiladigan yordamning miqdori fuqaroning ehtiyojidan kelib chiqib, ijtimoiy xodim tomonidan kiritiladi.</a></div><div class="ACT_TEXT"><a id="-6974536">17. “Mahalla yettiligi” tomonidan ijtimoiy xodimning tavsiyanomasi har bir oila bo‘yicha alohida ko‘rib chiqilib, ovoz beriladi hamda “Mahalla yettiligi” a’zolarining oddiy ko‘pchilik ovozi bilan oilaga yordam ko‘rsatish bo‘yicha qaror qabul qilinadi. Bunda ovozlar teng bo‘lib qolganda, ijtimoiy xodimning ovozi hal qiluvchi ahamiyatga ega bo‘ladi.</a></div><div class="ACT_TEXT"><a id="-6974537">Mazkur Nizomning <a href="javascript:scrollText(-6974531)">16-bandida</a> nazarda tutilgan muddatda “Mahalla yettiligi” vakillari tomonidan ovoz berilishi shart.</a></div><div class="ACT_TEXT"><a id="-6974538">“Mahalla yettiligi” vakillari tomonidan berilgan ovozlarga asosan qaror qabul qilish tartibi Agentlik tomonidan belgilanadi.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974539">[<b>OKOZ:</b><div id="LBC6533"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974539">18. “Mahalla yettiligi” tomonidan yordam ajratish bo‘yicha qaror qabul qilishda quyidagi shaxslar yoki oilalarga ustuvorlik beriladi:</a></div><div class="ACT_TEXT"><a id="-6974540">o‘zgalar parvarishiga muhtoj bo‘lgan yolg‘iz keksa va I va II guruh nogironligi bo‘lgan shaxslarga;</a></div><div class="ACT_TEXT"><a id="-6974541">boquvchisi nogironligi bo‘lgan shaxs bo‘lgan oilalarga;</a></div><div class="ACT_TEXT"><a id="-6974542">I va II guruh nogironligi bo‘lgan shaxs bo‘lgan yoki og‘ir kasallikka chalingan (butunlay yoki qisman o‘zini-o‘zi boqish imkoniga ega bo‘lmagan, faoliyati ko‘rsata olmaydigan) shaxslarga;</a></div><div class="ACT_TEXT"><a id="-6974543">boquvchisini yo‘qotgan oilalarga.</a></div><div class="ACT_TEXT"><a id="-6974544">19. Ushbu Nizomning 16-bandi <a href="javascript:scrollText(-6974533)">uchinchi xatboshisida</a> nazarda tutilgan bir nafar oilaga yordam ko‘rsatish ketma-ket uch marotaba keyingi oyga kechiktirilganda, yordamni tayinlash “Ijtimoiy himoya” AT tomonidan avtomatik ravishda rad etiladi.</a></div><div class="ACT_TEXT"><a id="-6974545">Bunda “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ajratiladigan yordamlarni olish uchun ijtimoiy yordam olish istagida bo‘lgan oila (shaxs) tomonidan qayta murojaat qilinishi mumkin.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974546">[<b>OKOZ:</b><div id="LBC6256"><span class="iorRN">1.</span><span class="iorVal">03.00.00.00 Fuqarolik qonunchiligi / 03.11.00.00 Majburiyatlarning alohida turlari / 03.11.07.00 Uy-joy ijarasi (shuningdek, 08.02.02.00 ga qarang);</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974546">20. Tuman (shahar) hokimliklari “Mahalla yettiligi”ning ijtimoiy himoyaga muhtoj oilalarga yordam ko‘rsatish to‘g‘risidagi qarorlarining ushbu mahalla fuqarolar yig‘inlariga ajratilgan mablag‘lar doirasida ko‘pi bilan bir oy muddatda ijrosini ta’minlaydi. Bunda:</a></div><div class="ACT_TEXT"><a id="-6974547">davolash muassasalariga hamda uy-joy ijarasi bo‘yicha to‘lovlar tegishli shartnomalar bo‘yicha to‘g‘ridan-to‘g‘ri o‘tkazib beriladi;</a></div><div class="ACT_TEXT"><a id="-6974548">tovar ko‘rinishidagi yordamlar tovarni (ishlarni, xizmatlarni) yetkazib beruvchilar maxsus axborot portalida e’lon joylashtirmasdan va xarid qilish tartib-taomillarini elektron shaklda o‘tkazmasdan, eng yaxshi takliflarni tanlash orqali aniqlanadi;</a></div><div class="ACT_TEXT"><a id="-6974549">pul ko‘rinishidagi yordamlar AT “Xalq banki”ning hududiy filiallarida ochilgan bank plastik kartalariga o‘tkazib beriladi. Bunda zarur ma’lumotlar AT “Xalq banki”ning tegishli axborot tizimlaridan olinadi.</a></div><div class="ACT_TEXT"><a id="-6974550">Ushbu bandning <a href="javascript:scrollText(-6974548)">uchinchi xatboshisida</a> nazarda tutilgan tovarlar bevosita yordam oluvchining yashash manziliga yetkazib beriladi hamda bu to‘g‘risida tovarni yetkazib beruvchi va “Mahalla yettiligi”ning bir nafar vakili ishtirokida dalolatnoma rasmiylashtiriladi.</a></div><div class="ACT_TEXT"><a id="-6974551">21. Ijtimoiy xodim tomonidan ushbu Nizomning <a href="javascript:scrollText(-6974515)">14</a> va <a href="javascript:scrollText(-6974518)">15-bandlarida</a> nazarda tutilgan tadbirlarni amalga oshirish jarayonida oilaga shoshilinch yordam ko‘rsatish lozimligi aniqlanganda, zudlik bilan “Ijtimoiy himoya” AT orqali tavsiyanoma shakllantiriladi hamda “shoshilinch” grifi ostida ko‘rib chiqish va qaror qabul qilish uchun “Mahalla yettiligi”ga kiritadi.</a></div><div class="ACT_TEXT"><a id="-6974552">Ushbu tavsiyanoma “Mahalla yettiligi” tomonidan bir sutka ichida ko‘rib chiqilishi shart.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974553">5-bob. “Saxovat va ko‘mak” jamg‘armasi mablag‘laridan foydalanish bo‘yicha hisob va hisobot</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974555">[<b>OKOZ:</b><div id="LBC6075"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.15.00.00 Mahalliy davlat hokimiyati organlari / 01.15.02.00 Hokim;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974555">22. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari tuman (shahar) hokimliklari tomonidan tasarruf etiladi.</a></div><div class="ACT_TEXT"><a id="-6974556">23. Tuman (shahar) hokimliklari quyidagilar uchun mas’ul hisoblanadi:</a></div><div class="ACT_TEXT"><a id="-6974557">ushbu Nizomning <a href="javascript:scrollText(-6974546)">20-bandida</a> nazarda tutilgan muddatda “Mahalla yettiligi”ning qarorida ko‘rsatilgan yordam bo‘yicha mablag‘larni moliyalashtirish;</a></div><div class="ACT_TEXT"><a id="-6974558">“Saxovat va ko‘mak” jamg‘armasi mablag‘laridan moliyalashtirilgan yordamlar to‘g‘risidagi ma’lumotlarni muntazam ravishda “Ijtimoiy himoya” ATga kiritib borish;</a></div><div class="ACT_TEXT"><a id="-6974559">“Saxovat va ko‘mak” jamg‘armasi mablag‘laridan maqsadli va samarali foydalanish.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974560">6-bob. Yakunlovchi qoidalar</a></div><div class="ACT_TEXT"><a id="-6974561">24. Qonunchilik hujjatlariga muvofiq bepul yoki imtiyozli tarzda yordam ko‘rsatiladigan shaxslarga “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan aynan shu turdagi yordam ko‘rsatilmaydi.</a></div><div class="ACT_TEXT"><a id="-6974562">25. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan yordam olish uchun murojaatlarni ko‘rib chiqish bosqichlari bo‘yicha ijtimoiy himoyaga muhtoj shaxslarga SMS-xabarnoma yuboriladi.</a></div><div class="ACT_TEXT"><a id="-6974563">Bunda SMS-xabarnoma yuborish bilan bog‘liq xarajatlar Ijtimoiy himoya davlat jamg‘armasi va qonunchilik hujjatlarida taqiqlanmagan boshqa manbalar hisobidan qoplanadi.</a></div><div class="ACT_TEXT"><a id="-6974564">26. “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ko‘rsatilgan yordamlar to‘g‘risidagi ma’lumotlar “Ijtimoiy himoya” ATga kiritib boriladi.</a></div><div class="ACT_TEXT"><a id="-6974565">27. Davlat moliyaviy nazorati inspeksiyasi va uning hududiy bo‘linmalari tomonidan mazkur Nizomga muvofiq tumanlar (shaharlar)da ijtimoiy yordamlar uchun ajratilgan mablag‘larning samarali va maqsadli ishlatilishi bo‘yicha nazorat amalga oshiriladi.</a></div><div class="ACT_TEXT"><a id="-6974566">28. Mazkur Nizom talablarining buzilishida aybdor shaxslar qonunchilik hujjatlarida belgilangan tartibda javob beradilar.</a></div><div class="BY_DEFAULT"><a id="-6974567"></a></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><a id="-6974568">Vazirlar Mahkamasining 2024-yil 31-maydagi 313-son <a href="-http://cli.lex.uz/ld/lps/doc/6973951">qaroriga</a> <br />2-ILOVA </a></div><div class="ACT_TITLE_APPL"><a id="-6974569">Og‘ir ijtimoiy ahvolga tushib qolgan oilalarni “Temir daftar”ga kiritish, hisobini yuritish hamda undan chiqarish tartibi to‘g‘risida</a></div><div class="ACT_FORM"><a id="-6974570">NIZOM</a></div><div class="BY_DEFAULT"><a id="-6974571"></a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974572">1-bob. Umumiy qoidalar</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974573">[<b>OKOZ:</b><div id="LBC9109"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish;</span></div><div id="LBC6533"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.10.00.00 Nogironlar va fuqarolarning boshqa toifalarining ijtimoiy himoyasi]</span></div></a></div><div class="ACT_TEXT"><a id="-6974573">1. Mazkur Nizom og‘ir ijtimoiy ahvolga tushib qolgan oilalarni aniqlash, “Temir daftar”ga kiritish, ularning ijtimoiy muammolarini bartaraf etishga qaratilgan yordam ko‘rsatish tartibini belgilaydi.</a></div><div class="ACT_TEXT"><a id="-6974574">2. “Temir daftar” “Yagona milliy ijtimoiy himoya” axborot tizimi orqali O‘zbekiston Respublikasi Prezidenti huzuridagi Ijtimoiy himoya milliy agentligi hamda uning hududiy bo‘linmalari tomonidan yuritiladi.</a></div><div class="ACT_TEXT"><a id="-6974575">3. Og‘ir ijtimoiy ahvolga tushib qolgan oilalar “Temir daftar”ga ushbu Nizomga <a href="javascript:scrollText(-6974662)">ilovaga</a> muvofiq sxema bo‘yicha kiritiladi.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974576">2-bob. Og‘ir ijtimoiy ahvolga tushib qolgan oilalarni “Temir daftar”ga kiritish tartibi</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974577">[<b>OKOZ:</b><div id="LBC6018"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.06.00.00 Inson va fuqaroning huquqlari, erkinliklari va burchlari / 01.06.04.00 Asosiy (Konstitutsiyaviy) ijtimoiy-iqtisodiy huquq va erkinliklar / 01.06.04.03 Qariganda, mehnat layoqatini yo‘qotganda, shuningdek boquvchisidan mahrum bo‘lganda ijtimoiy ta’minot olish huquqi;</span></div><div id="LBC6473"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.01.00.00 Umumiy qoidalar;</span></div><div id="LBC9109"><span class="iorRN">3.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish]</span></div></a></div><div class="ACT_TEXT"><a id="-6974577">4. Quyidagi oilalar “Temir daftar”ga kiritiladi:</a></div><div class="ACT_TEXT"><a id="-6974578">a) bir vaqtning o‘zida oilada:</a></div><div class="ACT_TEXT"><a id="-6974579">mehnatga layoqatli shaxs mavjud bo‘lmasa yoki yagona boquvchisi og‘ir kasal yoki nogironligi bo‘lgan oila a’zosi (lari)ni parvarish qilish bilan band bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974580">og‘ir kasal yoki nogironligi bo‘lgan oila a’zosi mavjud bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974581">oilaning moddiy ahvoli og‘ir bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974582">uy-joyi yo‘q yoki holati yomon ahvolda bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974583">b) bir vaqtning o‘zida oilada:</a></div><div class="ACT_TEXT"><a id="-6974584">mehnatga layoqatli shaxs mavjud bo‘lmasa yoki yagona boquvchisi og‘ir kasal bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974585">oila a’zosi yolg‘iz yoki yolg‘iz yashovchi bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974587">oilaning moddiy ahvoli og‘ir bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974588">uy-joyi yo‘q yoki holati yomon ahvolda bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974590">v) bir vaqtning o‘zida oilada:</a></div><div class="ACT_TEXT"><a id="-6974591">mehnatga layoqatli shaxs mavjud bo‘lmasa yoki yagona boquvchisi og‘ir kasal yoki nogironligi bo‘lgan oila a’zosi (lari)ni parvarish qilish bilan band bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974592">boquvchisini yo‘qotgan bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974593">oilaning moddiy ahvoli og‘ir bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974595">uy-joyi yo‘q yoki holati yomon ahvolda bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974596">g) bir vaqtning o‘zida oilada:</a></div><div class="ACT_TEXT"><a id="-6974597">yagona boquvchi 3 va undan ortiq voyaga yetmagan farzandlarini tarbiyalayotgan yolg‘iz ona (ota, vasiy yoki homiy) bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974598">oilaning moddiy ahvoli og‘ir bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974600">uy-joyi yo‘q yoki holati yomon ahvolda bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974602">d) bir vaqtning o‘zida oilada:</a></div><div class="ACT_TEXT"><a id="-6974604">2 va undan ortiq oila a’zolarida og‘ir kasallik yoki I va II guruh nogironligi belgilangan bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974605">oilaning moddiy ahvoli og‘ir bo‘lsa;</a></div><div class="ACT_TEXT"><a id="-6974606">uy-joyi yo‘q yoki holati yomon ahvolda bo‘lsa.</a></div><div class="ACT_TEXT"><a id="-6974608">5. Ushbu Nizomning <a href="javascript:scrollText(-6974577)">4-bandida</a> belgilangan oilalar voyaga yetgan a’zolarining “Temir daftar”ga kiritish uchun “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi o‘rinlarda — “Ijtimoiy himoya” AT) orqali yoki bevosita “Inson” ijtimoiy xizmatlar markazlariga borish orqali taqdim etgan murojaati yoxud “Inson” ijtimoiy xizmatlar markazlarining ijtimoiy xodimlari tomonidan xonadonma-xonadon yurish jarayonida aniqlangan holatlar bo‘yicha kiritiladi.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974609">[<b>OKOZ:</b><div id="LBC9109"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish]</span></div></a></div><div class="ACT_TEXT"><a id="-6974609">6. Oilaning “Temir daftar”ga kiritish haqidagi murojaati yoki ijtimoiy xodim tomonidan aniqlangan holatlar bo‘yicha ikki ish kunida “Inson” ijtimoiy xizmatlar markazlarining ijtimoiy xodimlari tomonidan ushbu oilalar (shaxslar)ning mazkur Nizom <a href="javascript:scrollText(-6974577)">4-bandida</a> belgilangan toifaga to‘g‘ri kelishi keys-menejment usuli orqali o‘rganish natijasida aniqlanadi.</a></div><div class="ACT_TEXT"><a id="-6974610">7. “Inson” ijtimoiy xizmatlar markazlarining ijtimoiy xodimlari tomonidan murojaatda keltirilgan oila ushbu Nizomning <a href="javascript:scrollText(-6974577)">4-bandida</a> belgilangan toifaga to‘g‘ri kelishi to‘g‘risida xulosaga kelinganda, “Ijtimoiy himoya” AT orqali “Temir daftar”ga kiritish bo‘yicha tavsiyanoma shakllantiriladi.</a></div><div class="ACT_TEXT"><a id="-6974611">Bunda tavsiyanomani shakllantirishdan avval “Temir daftar”ga kiritish so‘ralayotgan oilaning ijtimoiy himoyaga muhtojligi, shu jumladan, moddiy ahvoli, uning ixtiyorida bo‘lgan ko‘char va ko‘chmas mulklar hamda ijtimoiy himoyaga muhtoj shaxslar (oilalar) kiritiladigan boshqa daftar va reyestrlarga kiritilganligi yoki ulardan yordam olganligiga doir va boshqa ma’lumotlar idoralararo elektron axborot tizimi orqali “Saxovat va ko‘mak” jamg‘armasi mablag‘laridan yordam ko‘rsatish bo‘yicha tavsiyanoma shakllantirish uchun belgilangan tartibda tekshiriladi.</a></div><div class="ACT_TEXT"><a id="-6974612">Shakllantirilgan tavsiyanoma bir ish kuni ichida ko‘rib chiqish uchun “Mahalla yettiligi”ga kiritiladi.</a></div><div class="ACT_TEXT"><a id="-6974613">8. Ijtimoiy xodim tomonidan murojaatda keltirilgan oila ushbu Nizomning <a href="javascript:scrollText(-6974577)">4-bandida</a> belgilangan toifaga to‘g‘ri kelmasligi to‘g‘risida xulosaga kelinganda, murojaat bo‘yicha asoslantirilgan javob xati yuboriladi.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974614">[<b>OKOZ:</b><div id="LBC6077"><span class="iorRN">1.</span><span class="iorVal">01.00.00.00 Konstitutsiyaviy tuzum / 01.16.00.00 Fuqarolarning o‘zini o‘zi boshqarish organlari (shuningdek, 02.05.00.00ga qarang);</span></div><div id="LBC9109"><span class="iorRN">2.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish]</span></div></a></div><div class="ACT_TEXT"><a id="-6974614">9. “Mahalla yettiligi” ijtimoiy xodimning tavsiyanomasini uch ish kuni ichida kollegial tarzda ko‘rib chiqib, oddiy ko‘pchilik ovozi bilan quyidagi qarorlardan birini qabul qiladi:</a></div><div class="ACT_TEXT"><a id="-6974616">oilani “Temir daftar”ga kiritish to‘g‘risida;</a></div><div class="ACT_TEXT"><a id="-6974618">oilani “Temir daftar”ga kiritishni rad etish to‘g‘risida.</a></div><div class="ACT_TEXT"><a id="-6974620">“Mahalla yettiligi” tomonidan qaror qabul qilishda ovozlar teng bo‘lib qolgan taqdirda, ijtimoiy xodimning ovozi hal qiluvchi ahamiyatga ega bo‘ladi.</a></div><div class="ACT_TEXT"><a id="-6974621">“Mahalla yettiligi” tomonidan qabul qilinadigan qaror matni “Ijtimoiy himoya” ATda avtomatik shakllantiriladi.</a></div><div class="ACT_TEXT"><a id="-6974622">10. “Mahalla yettiligi”ning qarori bir ish kuni ichida murojaat qilgan oilaga yetkaziladi.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974625">3-bob. “Temir daftar”ga kiritilgan oilalarga ijtimoiy yordam va xizmatlar ko‘rsatish</a></div><div class="ACT_TEXT"><a id="-6974626">11. “Ijtimoiy himoya” ATda “Temir daftar”ga kiritilgan oilalarning tarkibi, oila a’zolari haqidagi batafsil ma’lumot, oilaning zaif tomonlari, muhtojligi ko‘rsatiladi.</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974627">[<b>OKOZ:</b><div id="LBC9109"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish;</span></div><div id="LBC8962"><span class="iorRN">2.</span><span class="iorVal">07.00.00.00 Moliya va kredit to‘g‘risidagi qonunchilik. Bank faoliyati / 07.05.00.00 Respublika budjeti / 07.05.13.00 Davlat subsidiyalari va grantlari]</span></div></a></div><div class="ACT_TEXT"><a id="-6974627">12. “Temir daftar”ga kiritilgan oilaga:</a></div><div class="ACT_TEXT"><a id="-6974629">qonunchilikda belgilangan tartib va miqdorlarda “Ayollar daftari” va “Yoshlar daftari” hamda Aholini tadbirkorlikka jalb qilish jamg‘armasi, Bandlikka ko‘maklashish davlat jamg‘armasi, Hunarmandchilik va kasanachilikni qo‘llab-quvvatlash jamg‘armasi hamda “Saxovat va ko‘mak” jamg‘armasi orqali ijtimoiy yordam ko‘rsatiladi va subsidiyalar ajratiladi;</a></div><div class="ACT_TEXT"><a id="-6974630">ularning roziligi bilan homiylik yordamlarini maqsadli jalb qilish uchun tegishli ma’lumotlar ochiq tarzda “Ijtimoiy himoya” ATdagi kraudfanding platformasida aks ettiriladi.</a></div><div class="ACT_TEXT"><a id="-6974631">13. Kraudfanding platformasi orqali:</a></div><div class="ACT_TEXT"><a id="-6974632">xayriya qilish istagida bo‘lgan shaxslar keyslarni ko‘rib chiqib, to‘liq yoki qisman homiylik qilishi mumkin;</a></div><div class="ACT_TEXT"><a id="-6974634">homiylik yordamlari to‘g‘ridan-to‘g‘ri natura shaklida muhtoj oilaning o‘ziga yoki “Saxovat va ko‘mak” jamg‘armasiga maqsadli ravishda yo‘naltirilishi mumkin;</a></div><div class="ACT_TEXT"><a id="-6974636">ko‘rsatilgan yordamlar ijtimoiy xodim tomonidan kraudfanding platformasida aks ettirib boriladi;</a></div><div class="ACT_TEXT"><a id="-6974637">ochilgan keyslarni xayriya qiluvchilar geografik hududlar kesimida ko‘rishi mumkin.</a></div><div class="ACT_TEXT"><a id="-6974640">14. “Temir daftar”ga kiritilgan oilalarga bir yil davomida “Saxovat va ko‘mak” jamg‘armasi mablag‘lari hisobidan ko‘rsatiladigan yordamlar soni cheklanmaydi.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974641">4-bob. “Temir daftar”dan chiqarish tartibi</a></div><div class="INDEXES_ON_REF" style="display:none"><label id="s5987"></label><a id="onLBC-6974642">[<b>OKOZ:</b><div id="LBC9109"><span class="iorRN">1.</span><span class="iorVal">06.00.00.00 Ijtimoiy ta’minot va ijtimoiy sug‘urta to‘g‘risidagi qonunchilik. Ijtimoiy himoya / 06.07.00.00 Nafaqalar. Kompensatsiya to‘lovlari / 06.07.03.00 Kam ta’minlanganlar, “Ayollar daftari”, “Yoshlar daftari”, “Temir daftar” va boshqa toifalardagi fuqarolarga moddiy yordam ko‘rsatish;</span></div><div id="LBC7573"><span class="iorRN">2.</span><span class="iorVal">16.00.00.00 Xavfsizlik va huquq tartibot muhofazasi / 16.12.00.00 Jinoyat-protsessual qonunchiligi / 16.12.12.00 Hukm, ajrim va qarorlarni ijro qilish]</span></div></a></div><div class="ACT_TEXT"><a id="-6974642">15. Oilalar quyidagi hollarda “Temir daftar” dan chiqariladi:</a></div><div class="ACT_TEXT"><a id="-6974644">har bir toifa bo‘yicha belgilangan yordamlar to‘liq ko‘rsatilganda;</a></div><div class="ACT_TEXT"><a id="-6974645">to‘liq davlat ta’minotiga olinganda;</a></div><div class="ACT_TEXT"><a id="-6974646">o‘z arizasiga ko‘ra;</a></div><div class="ACT_TEXT"><a id="-6974647">“Temir daftar”ga kirishda noto‘g‘ri ma’lumotlar taqdim etilganligi aniqlanganda;</a></div><div class="ACT_TEXT"><a id="-6974648">boshqa davlatlarga doimiy yashash uchun chiqib ketganda;</a></div><div class="ACT_TEXT"><a id="-6974649">sudning ozodlikdan mahrum etishni nazarda tutuvchi hukmi qonuniy kuchga kirganda;</a></div><div class="ACT_TEXT"><a id="-6974650">shaxs vafot etgan taqdirda yoki sud qarori asosida bedarak yo‘qolgan deb topilganda.</a></div><div class="ACT_TEXT"><a id="-6974651">16. Ijtimoiy xodim mazkur Nizomning <a href="javascript:scrollText(-6974642)">15-bandida</a> ko‘rsatilgan holatlarga asosan oilalarni “Temir daftar”dan chiqarish bo‘yicha “Mahalla yettiligi”ga “Ijtimoiy himoya” AT orqali tavsiya beradi.</a></div><div class="ACT_TEXT"><a id="-6974652">17. “Mahalla yettiligi” ijtimoiy xodim tomonidan “Temir daftar”dan chiqarish tavsiya etilayotgan oilalarni uch ish kuni ichida mazkur Nizomning <a href="javascript:scrollText(-6974642)">15-bandida</a> nazarda tutilgan asoslardan birining mavjudligi bo‘yicha o‘rganib chiqadi.</a></div><div class="ACT_TEXT"><a id="-6974653">Ijtimoiy xodim tavsiyasi “Mahalla yettiligi” a’zolarining oddiy ko‘pchilik ovozi bilan ma’qullangan taqdirda, oilani “Temir daftar”dan chiqarish bo‘yicha qaror qabul qilinadi va bu to‘g‘risidagi ma’lumot “Ijtimoiy himoya” ATga kiritiladi.</a></div><div class="ACT_TEXT"><a id="-6974654">18. “Temir daftar”dan chiqarilayotgan oilalar ijtimoiy xodim tomonidan bir kun ichida bu haqda xabardor qilinadi.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="-6974655">5-bob. Yakunlovchi qoidalar</a></div><div class="ACT_TEXT"><a id="-6974656">19. “Inson” ijtimoiy xizmatlar markazi “Ijtimoiy himoya” ATga ma’lumotlarning kiritilishi yuzasidan monitoring yuritadi.</a></div><div class="ACT_TEXT"><a id="-6974657">20. “Temir daftar”ga kirish bo‘yicha qilingan murojaatlarni ko‘rib chiqish bosqichlari bo‘yicha ijtimoiy himoyaga muhtoj shaxslarga SMS-xabarnoma yuboriladi.</a></div><div class="ACT_TEXT"><a id="-6974660">Bunda SMS-xabarnoma yuborish bilan bog‘liq xarajatlar Ijtimoiy himoya davlat jamg‘armasi va qonunchilik hujjatlarida taqiqlanmagan boshqa manbalar hisobidan qoplanadi.</a></div><div class="ACT_TEXT"><a id="-6974661">21. Mazkur Nizom talablarining buzilishida aybdor bo‘lgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javob beradilar.</a></div><div class="BY_DEFAULT"><a id="-6974662"></a></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><a id="-6974665">Og‘ir ijtimoiy ahvolga tushib qolgan oilalarni “Temir daftar”ga kiritish, hisobini yuritish hamda undan chiqarish tartibi to‘g‘risidagi <a href="javascript:scrollText(-6974569)">nizomga</a> <br />ILOVA </a></div><div class="ACT_TITLE_APPL"><a id="-6974745">Og‘ir ijtimoiy ahvolga tushib qolgan oilalarni “Temir daftar”ga kiritish</a></div><div class="ACT_FORM"><a id="-6974746">SXEMASI</a></div><div class="BY_DEFAULT"><a id="-6974747"></a></div><div class="BY_DEFAULT"><a id="-6974748"><table style="BORDER-COLLAPSE: collapse" cellspacing="0" cellpadding="0" width="100%" border="0"><tbody><tr style="HEIGHT: 14.2pt"><td style="BORDER-TOP: windowtext 1pt solid; HEIGHT: 14.2pt; BORDER-RIGHT: windowtext 1pt solid; BACKGROUND: white; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 0cm; PADDING-TOP: 0cm; PADDING-LEFT: 2.85pt; BORDER-LEFT: windowtext 1pt solid; PADDING-RIGHT: 2.85pt" rowspan="2" width="12%"><p align="center"><strong>Bosqichlar</strong></p></td><td style="HEIGHT: 14.2pt; BORDER-RIGHT: windowtext 1pt solid; BACKGROUND: white; PADDING-BOTTOM: 0cm; PADDING-TOP: 0cm; PADDING-LEFT: 2.85pt; PADDING-RIGHT: 2.85pt" width="2%"><p align="center"></p></td><td style="BORDER-TOP: windowtext 1pt solid; HEIGHT: 14.2pt; BORDER-RIGHT: windowtext 1pt solid; BACKGROUND: white; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 0cm; PADDING-TOP: 0cm; PADDING-LEFT: 2.85pt; PADDING-RIGHT: 2.85pt" rowspan="2" width="15%"><p align="center"><strong>Subyektlar</strong></p></td><td style="HEIGHT: 14.2pt; BORDER-RIGHT: windowtext 1pt solid; BACKGROUND: white; PADDING-BOTTOM: 0cm; PADDING-TOP: 0cm; PADDING-LEFT: 2.85pt; PADDING-RIGHT: 2.85pt" width="2%"><p align="center"></p></td><td style="BORDER-TOP: windowtext 1pt solid; HEIGHT: 14.2pt; BORDER-RIGHT: windowtext 1pt solid; BACKGROUND: white; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 0cm; PADDING-TOP: 0cm; PADDING-LEFT: 2.85pt; PADDING-RIGHT: 2.85pt" rowspan="2" width="48%"><p align="center"><strong>Tadbirlar</strong></p></td><td style="HEIGHT: 14.2pt; BORDER-RIGHT: 