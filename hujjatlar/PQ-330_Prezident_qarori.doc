			<p align="center" style="text-align:center; text-indent:0cm"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Ikki oy muddatda</span></span></span></span></span></p>
			</td>
			<td style="border-bottom:1px solid black; width:16%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none" valign="top">
			<p align="center" style="text-align:center; text-indent:0cm"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Ijtimoiy himoya milliy agentligi</span></span></span></span></span></p>

			<p align="center" style="text-align:center; text-indent:0cm"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">(J. Abruyev),</span></span></i></span></span></span></p>

			<p align="center" style="text-align:center; text-indent:0cm"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Kambag‘allikni qisqartirish va bandlik vazirligi</span></span></span></span></span></p>
