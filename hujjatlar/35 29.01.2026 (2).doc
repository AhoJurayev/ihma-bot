<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-8029782" id="-8029782">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-8029783" id="-8029783">qarori</div></div><div class="ACT_TITLE"><div name="-8029784" id="-8029784"><b>Ijtimoiy reyestrga kiritilgan oilalarni qoʻllab-quvvatlash tizimini takomillashtirishning qoʻshimcha chora-tadbirlari toʻgʻrisida</b></div></div><div class="BY_DEFAULT"><div name="-8029786" id="-8029786"></div></div><div class="ACT_TEXT"><div name="-8029787" id="-8029787">Oʻzbekiston Respublikasi Prezidentining “Ijtimoiy himoyaga muhtoj aholi qatlamlariga davlat ijtimoiy qoʻllab-quvvatlash choralarini taqdim etish tizimini tubdan takomillashtirish chora-tadbirlari toʻgʻrisida” 2025-yil 26-dekabrdagi PF-258-son <a href="https://lex.uz/uz/docs/-7952180">Farmoni </a>ijrosini taʼminlash maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="ACT_TEXT"><div name="-8029788" id="-8029788">1. Quyidagilar:</div></div><div class="ACT_TEXT"><div name="-8029790" id="-8029790">Ijtimoiy reyestrni yuritish tartibi toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-8027513#-8029844">1-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029792" id="-8029792">Ijtimoiy reyestrga kiritilgan oilalarga individual reja ishlab chiqish va uning ijrosini taʼminlash tartibi toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-8027513#-8030232">2-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029794" id="-8029794">Ijtimoiy reyestrga kiritilgan oilalarga bolalar nafaqasi va moddiy yordam tayinlash va toʻlash tartibi toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-8027513#-8030308">3-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029796" id="-8029796">Tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlari toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-8027513#-8030433">4-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029798" id="-8029798">“Yagona milliy ijtimoiy himoya” axborot tizimidagi idoralararo elektron oʻzaro axborot almashinuvi doirasidagi maʼlumotlar roʻyxati <a href="https://lex.uz/uz/docs/-8027513#-8030581">5-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029800" id="-8029800">Ijtimoiy reyestrga kiritilgan oilalarga koʻrsatiladigan davlat ijtimoiy qoʻllab-quvvatlash choralari roʻyxati <a href="https://lex.uz/uz/docs/-8027513#-8030589">6-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-8029802" id="-8029802">Ijtimoiy reyestrga kiritilgan oilalarga koʻrsatiladigan davlat ijtimoiy qoʻllab-quvvatlash choralari doirasida “Yagona milliy ijtimoiy himoya” axborot tizimiga “Raqamli hukumat” tizimining Idoralararo integratsiyalashuv platformasi orqali taqdim etiladigan maʼlumotlar toʻplamlari roʻyxati <a href="https://lex.uz/uz/docs/-8027513#-8030598">7-ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-8029804" id="-8029804">2. Belgilansinki:</div></div><div class="ACT_TEXT"><div name="-8029806" id="-8029806">a) 2026-yil 1-fevralga qadar:</div></div><div class="ACT_TEXT"><div name="-8029808" id="-8029808">“Ijtimoiy himoya yagona reyestri” axborot tizimi orqali bolalar nafaqasi va moddiy yordam oluvchi hamda Kambagʻal oilalar reyestriga kiritilgan va ushbu reyestrga tushish xavfi boʻlgan “yashil” toifadagi oilalarning ijtimoiy-iqtisodiy holati “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi oʻrinlarda — “YAMIH” AT)da avtomatik tarzda baholashdan oʻtkaziladi va Ijtimoiy reyestrga kiritish mezonlariga mos keladigan oilalar mazkur reyestrga qoʻshimcha ariza talab etmagan holda oʻtkaziladi;</div></div><div class="ACT_TEXT"><div name="-8029810" id="-8029810">bolalar nafaqasi yoki moddiy yordam tayinlangan Ijtimoiy reyestrga oʻtkazilgan oilalarga mazkur toʻlovlarni toʻlash qoʻshimcha ariza talab etmagan holda ularning toifasiga muvofiq davom ettiriladi. Bunda Ijtimoiy reyestrning “kambagʻal oila” toifasiga oʻtkazilgan oilalar uchun mehnatga layoqatli oila aʼzolarining rasmiy bandligini taʼminlash uchun belgilangan muddat ular ushbu reyestrga oʻtkazilgan sanadan boshlab hisoblanadi;</div></div><div class="ACT_TEXT"><div name="-8029812" id="-8029812">Ijtimoiy reyestrga oʻtkazilgan oilalarning ijtimoiy-iqtisodiy holatini qayta baholashdan oʻtkazish muddati ularga tegishlicha “Ijtimoiy himoya yagona reyestri” axborot tizimi orqali bolalar nafaqasi yoki moddiy yordam tayinlangan yoxud Kambagʻal oilalar reyestriga kiritilgan sanadan boshlab hisoblanadi;</div></div><div class="ACT_TEXT"><div name="-8029814" id="-8029814">b) “mahalla yettiligi” tomonidan tasdiqlangan individual rejalarga kiritilgan ijtimoiy xizmat, yordam va imtiyozlarni (keyingi oʻrinlarda — davlat ijtimoiy qoʻllab-quvvatlash choralari) taqdim etish vazirlik va idoralar, ularning tizim tashkilotlari tomonidan taʼminlanadi hamda ularning natijasi boʻyicha “YAMIH” ATda tegishli axborot tizimlarini integratsiya qilish orqali real vaqt rejimida maʼlumot almashish (ijro qadamlari va natijasini koʻrish) imkoniyati yaratiladi;</div></div><div class="ACT_TEXT"><div name="-8029816" id="-8029816">v) Ijtimoiy reyestrga kiritilgan oilalarga shakllantirilgan individual rejalarda belgilangan davlat ijtimoiy qoʻllab-quvvatlash choralarining ijrosi holati tuman (shahar) hokimlarining eng muhim samaradorlik koʻrsatkichlaridan biri sifatida inobatga olinadi;</div></div><div class="ACT_TEXT"><div name="-8029818" id="-8029818">g) Ijtimoiy himoya milliy agentligi tomonidan fuqarolarni Ijtimoiy reyestrga kiritish yoki chiqarish bilan bogʻliq jarayonlar natijalari yuzasidan maʼlumot berish ularning mobil telefon raqamlariga bepul qisqa SMS-xabarlar yuborish orqali amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029820" id="-8029820">Ijtimoiy himoya milliy agentligi 2026-yil 1-fevralga qadar “Ijtimoiy himoya yagona reyestri” axborot tizimi orqali bolalar nafaqasi va moddiy yordam oluvchi hamda Kambagʻal oilalar reyestriga kiritilgan va ushbu reyestrga tushish xavfi boʻlgan “yashil” toifadagi oilalarni mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8029806">“a” kichik bandiga</a> muvofiq Ijtimoiy reyestrga oʻtkazilishini va bolalar nafaqasi yoki moddiy yordam olayotgan oilalarga toʻlovlar uzluksiz davom ettirilishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-8029822" id="-8029822">3. Ijtimoiy himoya milliy agentligi va Raqamli texnologiyalar vazirligi manfaatdor vazirlik va idoralar bilan birgalikda:</div></div><div class="ACT_TEXT"><div name="-8029824" id="-8029824">a) ikki oy muddatda “YAMIH” ATda quyidagilar boʻyicha texnik imkoniyatlar yaratsin:</div></div><div class="ACT_TEXT"><div name="-8029826" id="-8029826">Ijtimoiy reyestrga kiritiladigan oilalarni aniqlash boʻyicha savolnomani imzoni identifikatsiya qilishning zamonaviy vositalari bilan (shaxsning yuzini biometrik identifikatsiya qilish texnologiyasi (Face-ID), elektron raqamli imzo, daktiloskopiya va boshqalar) yoki SMS-xabar bilan tasdiqlash;</div></div><div class="ACT_TEXT"><div name="-8029827" id="-8029827">manfaatdor shaxslarning Ijtimoiy reyestrni yuritish jarayonida rasmiylashtiriladigan dalolatnoma va xulosalar boʻyicha shikoyatlarini tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlarida koʻrib chiqish va qaror qabul qilish;</div></div><div class="ACT_TEXT"><div name="-8029828" id="-8029828">“YAMIH” AT, Yagona interaktiv davlat xizmatlari portali va “Ijtimoiy karta” mobil ilovasi orqali Ijtimoiy reyestrga kiritish hamda bolalar nafaqasi va moddiy yordam tayinlash uchun murojaat qilish;</div></div><div class="ACT_TEXT"><div name="-8029829" id="-8029829">b) uch oy muddatda mazkur qarorga <a href="https://lex.uz/uz/docs/-8027513#-8030589">6-ilovadagi</a> raqamlashtirilmagan davlat ijtimoiy qoʻllab-quvvatlash choralarini “YAMIH” AT orqali elektron taqdim etish boʻyicha texnik imkoniyat yaratsin. Bunda vazirlik va idoralar Raqamli texnologiyalar vazirligi bilan birgalikda 2027-yil 1-yanvarga qadar <a href="https://lex.uz/uz/docs/-8027513#-8030589">6-ilovadagi</a> raqamlashtirilmagan davlat ijtimoiy qoʻllab-quvvatlash choralarini taqdim etish uchun oʻz axborot tizimlarini ishlab chiqsin va amaliyotga joriy etsin;</div></div><div class="ACT_TEXT"><div name="-8029830" id="-8029830">v) 2027-yil 1-yanvarga qadar fuqarolarga <a href="https://lex.uz/uz/docs/-8027513#-8030589">6-ilovadagi</a> davlat ijtimoiy qoʻllab-quvvatlash choralaridan “Ijtimoiy karta” mobil ilovasi orqali foydalanishni bosqichma-bosqich tashkil etish boʻyicha Vazirlar Mahkamasiga taklif kiritsin.</div></div><div class="ACT_TEXT"><div name="-8029831" id="-8029831">4. Raqamli texnologiyalar vazirligi, Adliya vazirligi manfaatdor vazirlik va idoralar bilan birgalikda ikki oy muddatda mazkur qarorga <a href="https://lex.uz/uz/docs/-8027513#-8030581">5</a> va <a href="https://lex.uz/uz/docs/-8027513#-8030598">7-ilovalarda</a> nazarda tutilgan maʼlumotlar “Raqamli hukumat” tizimining Idoralararo integratsiyalashuv platformasi orqali “YAMIH” ATga taqdim etilishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-8029832" id="-8029832">5. Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahri hokimliklari:</div></div><div class="ACT_TEXT"><div name="-8029833" id="-8029833">bir oy muddatda tuman (shahar) hokimliklari huzurida nizolarni hal qilish boʻyicha apellyatsiya kengashlari tashkil etilishini;</div></div><div class="ACT_TEXT"><div name="-8029834" id="-8029834">Ijtimoiy reyestrga kiritilgan oilalarga shakllantirilgan individual rejalarning bajarilishi har oyda bir marotaba muhokama qilib borilishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-8029835" id="-8029835">6. Boshqaruv samaradorligi agentligi individual rejalarning ijro holati mahalliy ijro etuvchi hokimiyat organlari rahbarlarining faoliyatini baholashda alohida koʻrsatkich sifatida belgilanishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-8029836" id="-8029836">7. Oʻzbekiston Respublikasi Hukumatining <a href="https://lex.uz/uz/docs/-8027513#-8030622">8-ilovaga</a> muvofiq ayrim qarorlariga oʻzgartirish va qoʻshimchalar kiritilsin.</div></div><div class="ACT_TEXT"><div name="-8029837" id="-8029837">8. Oʻzbekiston Respublikasi Hukumatining <a href="https://lex.uz/uz/docs/-8027513#-8030606">9-ilovaga</a> muvofiq baʼzi qarorlari oʻz kuchini yoʻqotgan deb hisoblansin.</div></div><div class="ACT_TEXT"><div name="-8029838" id="-8029838">9. Ijtimoiy himoya milliy agentligi manfaatdor vazirlik va idoralar bilan birgalikda oʻzlari qabul qilgan normativ-huquqiy hujjatlarni ikki oy muddatda ushbu qarorga muvofiqlashtirsin.</div></div><div class="ACT_TEXT"><div name="-8029839" id="-8029839">10. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Bosh vazirining oʻrinbosari — iqtisodiyot va moliya vaziri J.A. Qoʻchqorov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-8029840" id="-8029840">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-8029841" id="-8029841">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-8029842" id="-8029842">2026-yil 29-yanvar,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-8029843" id="-8029843"><span translate="no">35</span>-son</div></div><div class="BY_DEFAULT"><div name="-8029844" id="-8029844"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8029845" id="-8029845">Vazirlar Mahkamasining 2026-yil 29-yanvardagi 35-son <a href="https://lex.uz/uz/docs/-8027513">qaroriga</a><br />1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8029846" id="-8029846"><b>Ijtimoiy reyestrni yuritish tartibi toʻgʻrisida</b></div></div><div class="ACT_FORM"><div name="-8029847" id="-8029847">NIZOM</div></div><div class="BY_DEFAULT"><div name="-8029848" id="-8029848"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8029849" id="-8029849"><b>1-bob. Umumiy qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8029850" id="-8029850">1. Mazkur Nizom oilalarni Ijtimoiy reyestrga (keyingi oʻrinlarda — Reyestr) kiritish, toifalarga ajratish va Reyestrdan chiqarish tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-8029851" id="-8029851">2. Ushbu Nizomda quyidagi asosiy tushunchalardan foydalaniladi:</div></div><div class="ACT_TEXT"><div name="-8029852" id="-8029852"><b>ariza beruvchi</b> — Reyestrga kiritishni soʻrab murojaat qilgan oilaning muomalaga layoqatli aʼzosi (18 yoshga toʻlgan, 18 yoshga toʻlmasdan farzandli boʻlgan yoki oʻz oilasiga ega boʻlmagan Oʻzbekiston Respublikasi fuqarosi, Oʻzbekiston Respublikasi hududida yashash guvohnomasiga ega boʻlgan chet el fuqarosi yoki fuqaroligi boʻlmagan shaxs);</div></div><div class="ACT_TEXT"><div name="-8029853" id="-8029853"><b>vakolatli organ</b> — “Inson” ijtimoiy xizmatlar markazlari;</div></div><div class="ACT_TEXT"><div name="-8029854" id="-8029854"><b>Ijtimoiy reyestrga kiritiladigan oilalarni aniqlash boʻyicha savolnoma</b> (keyingi oʻrinlarda — savolnoma) — ariza beruvchi va oila aʼzolarining (agar mavjud boʻlsa) shaxsiga doir maʼlumotlarini oʻrganish hamda oilaning ijtimoiy-iqtisodiy ehtiyojlarini baholashga (aniqlashga) qaratilgan savollar jamlanmasi;</div></div><div class="ACT_TEXT"><div name="-8029855" id="-8029855"><b>“Ijtimoiy reyestr” axborot moduli </b>(keyingi oʻrinlarda — axborot moduli) — idoralararo elektron oʻzaro hamkorlikni qoʻllagan holda davlat taʼminotidagi, kambagʻal va kambagʻallik chegarasidagi oilalarni aniqlash, ularga ijtimoiy xizmat, yordam va imtiyozlarni (keyingi oʻrinlarda — davlat ijtimoiy qoʻllab-quvvatlash choralari) olish uchun murojaat qiluvchi va oluvchi oilalar toʻgʻrisida yagona maʼlumotlar bazasini shakllantirish amalga oshiriladigan, “Yagona milliy ijtimoiy himoya” axborot tizimining (keyingi oʻrinlarda — “YAMIH” AT) tarkibiy qismi boʻlgan maʼlumotlar bazasi;</div></div><div class="ACT_TEXT"><div name="-8029856" id="-8029856"><b>normativ daromad</b> — oilaning daromadini rasmiy maʼlumotlar orqali tasdiqlash imkoni boʻlmaganda shartli ravishda qoʻllaniladigan daromad miqdori;</div></div><div class="ACT_TEXT"><div name="-8029857" id="-8029857"><b>tabiiy hamda texnogen xususiyatli favqulodda vaziyatlar </b>(keyingi oʻrinlarda — favqulodda vaziyatlar) — muayyan hududda odamlar qurbon boʻlishiga, ularning sogʻligʻi yoki atrof tabiiy muhitga zarar yetishiga, jiddiy moddiy talafotlar keltirib chiqarishga hamda odamlarning hayot faoliyati sharoiti izdan chiqishiga olib kelishi mumkin boʻlgan yoki olib kelgan avariya, halokat, xavfli tabiiy hodisa, tabiiy yoki boshqa ofat, karantin va odamlar uchun xavfli boʻlgan boshqa yuqumli kasalliklarning tarqalishi natijasida muayyan hududda yuzaga kelgan vaziyatlar.</div></div><div class="ACT_TEXT"><div name="-8029858" id="-8029858">3. Reyestrga kiritish mezonlariga mos keladigan oilalarni aniqlash, ularni Reyestrga kiritish mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030161">1-ilovaga</a> muvofiq sxema asosida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029859" id="-8029859">4. Reyestrga kiritilgan oilalarga, ularga shakllantirilgan individual rejaga asosan qonunchilik hujjatlarida belgilangan davlat ijtimoiy qoʻllab-quvvatlash choralari taqdim etiladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8029860" id="-8029860"><b>2-bob. Oilani Reyestrga kiritish toʻgʻrisidagi murojaatni koʻrib chiqish tartibi</b></div></div><div class="ACT_TEXT"><div name="-8029861" id="-8029861">5. Ariza beruvchi oilasini Reyestrga kiritish uchun vakolatli organga quyidagi shakllarda murojaat qiladi:</div></div><div class="ACT_TEXT"><div name="-8029862" id="-8029862">davlat xizmatlari markazi yoki vakolatli organga borgan holda yoki yashash manzili boʻyicha mahallaga biriktirilgan ijtimoiy xodim orqali;</div></div><div class="ACT_TEXT"><div name="-8029863" id="-8029863">“YAMIH” AT, Yagona interaktiv davlat xizmatlari portali (keyingi oʻrinlarda — YIDXP) yoki “Ijtimoiy karta” mobil ilovasi orqali mustaqil ravishda.</div></div><div class="ACT_TEXT"><div name="-8029864" id="-8029864">Har bir oila tomonidan Reyestrga kiritish uchun ariza topshirish bir oyda bir marta amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029865" id="-8029865">6. Oilani Reyestrga kiritish toʻgʻrisidagi murojaat:</div></div><div class="ACT_TEXT"><div name="-8029866" id="-8029866">a) davlat xizmatlari markazi orqali berilganda, markaz xodimi ariza beruvchining nomidan mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030167">2-2a-ilovalarga</a> muvofiq shakldagi arizalarni toʻldiradi;</div></div><div class="ACT_TEXT"><div name="-8029867" id="-8029867">b) vakolatli organ yoki mahallaga biriktirilgan ijtimoiy xodim orqali berilganda, vakolatli organning masʼul xodimi yoki mahallaga biriktirilgan ijtimoiy xodim “YAMIH” ATda ariza beruvchining nomidan mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030167">2-2a-ilovalarga</a> muvofiq shakldagi arizalarni toʻldiradi;</div></div><div class="ACT_TEXT"><div name="-8029868" id="-8029868">v) “YAMIH” AT, YIDXP yoki “Ijtimoiy karta” mobil ilovasi orqali berilganda, ariza beruvchi mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030167">2-2a-ilovalarga</a> muvofiq shakldagi arizalarni mustaqil ravishda toʻldiradi.</div></div><div class="ACT_TEXT"><div name="-8029869" id="-8029869">Oilani Reyestrga kiritish toʻgʻrisidagi murojaat mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8029866">“a”</a> va <a href="https://lex.uz/uz/docs/-8027513#-8029867">“b” kichik bandlarida</a> belgilangan shakllarda taqdim etilganda ariza beruvchining shaxsi qonunchilik hujjatlarida belgilangan tartibda hujjatlarning unifikatsiyalangan raqamli servislari orqali, agar mazkur raqamli servislar orqali tasdiqlash imkoni boʻlmasa, bevosita ariza beruvchidan uning shaxsini tasdiqlovchi hujjatini (ID-karta, pasport, yashash guvohnomasi) talab qilish orqali tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8029870" id="-8029870">7. Ariza beruvchi arizani koʻrib chiqishning har qanday bosqichida xizmatdan foydalanishdan bosh tortish huquqiga ega. Bunda uning arizasi koʻrib chiqilmaydi.</div></div><div class="ACT_TEXT"><div name="-8029871" id="-8029871">8. Mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029861">5</a> va <a href="https://lex.uz/uz/docs/-8027513#-8029865">6-bandlarida</a> nazarda tutilgan tartibda ariza berilganda ariza beruvchi tomonidan imzoni identifikatsiya qilishning zamonaviy vositalari bilan (shaxsning yuzini biometrik identifikatsiya qilish texnologiyasi (Face-ID), elektron raqamli imzo, daktiloskopiya va boshqalar) yoki SMS-xabar bilan tasdiqlanadi. Bunda:</div></div><div class="ACT_TEXT"><div name="-8029872" id="-8029872">ariza beruvchi tomonidan arizaning tasdiqlanishi unga tegishli shaxsga doir maʼlumotlarni olish va ishlov berishga hamda savolnoma oʻtkazishga roziligini bildiradi;</div></div><div class="ACT_TEXT"><div name="-8029873" id="-8029873">ariza avtomatik ravishda “YAMIH” ATga yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8029874" id="-8029874">9. “YAMIH” ATda arizada koʻrsatilgan hamda idoralararo elektron hamkorlik orqali olinadigan maʼlumotlarga muvofiq oilaning ijtimoiy-iqtisodiy holati dastlabki tarzda baholashdan oʻtkaziladi.</div></div><div class="ACT_TEXT"><div name="-8029875" id="-8029875">“Mahalla yettiligi” tomonidan oxirgi uch oy ichida ariza beruvchi oilasining ijtimoiy-iqtisodiy holati boʻyicha xulosa tasdiqlangan boʻlsa, dastlabki baholash mazkur xulosa hamda idoralararo elektron hamkorlik orqali olinadigan maʼlumotlarga asosan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029876" id="-8029876">10. Dastlabki baholash natijasi boʻyicha:</div></div><div class="ACT_TEXT"><div name="-8029877" id="-8029877">ariza beruvchining oilasini mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029997">33-bandida</a> belgilangan “davlat taʼminotidagi oila” va “kambagʻal oila” deb topishni rad etish uchun asoslar aniqlanmaganda ariza ijtimoiy xodimning axborot modulidagi shaxsiy kabinetiga savolnoma toʻldirish uchun yuboriladi. Bunda oxirgi uch oy ichida ariza beruvchi oilasining ijtimoiy-iqtisodiy holati boʻyicha xulosa tasdiqlangan boʻlsa, yangidan savolnoma toʻldirilmaydi va mazkur xulosa oilaning ijtimoiy-iqtisodiy holatini yakuniy baholashdan oʻtkazish uchun avtomatik tarzda “YAMIH” ATga yuboriladi;</div></div><div class="ACT_TEXT"><div name="-8029878" id="-8029878">mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029997">33-bandida</a> belgilangan asoslar aniqlanganda ariza beruvchining oilasini “davlat taʼminotidagi oila” va “kambagʻal oila” deb eʼtirof etish rad etiladi.</div></div><div class="ACT_TEXT"><div name="-8029879" id="-8029879">Dastlabki baholash natijasi boʻyicha ariza ijtimoiy xodimga yuborilganligi va uch ish kuni ichida savolnoma oʻtkazilishi yoki oilani Reyestrga kiritish rad etilganligi toʻgʻrisida ariza beruvchining arizada koʻrsatilgan mobil telefon raqamiga SMS-xabar yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8029880" id="-8029880">11. Ijtimoiy xodim ariza uning axborot modulidagi shaxsiy kabinetiga kelib tushgandan soʻng uch ish kuni ichida oilaning ijtimoiy-iqtisodiy holatini aniqlash uchun ariza beruvchining xonadoniga borgan holda, ariza beruvchi yoki muomalaga layoqatli oila aʼzosi ishtirokida mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030193">3-ilovaga</a> muvofiq shakldagi savolnomani axborot modulida elektron shaklda toʻldiradi.</div></div><div class="ACT_TEXT"><div name="-8029881" id="-8029881">12. Ariza beruvchi yoki uning muomalaga layoqatli oila aʼzosi toʻldirilgan savolnoma bilan tanishtiriladi va ular savolnomaga kiritilgan maʼlumotlarga rozilik bildirganda imzolarni identifikatsiya qilishning tegishli vositalari (shaxsning yuzini biometrik identifikatsiya qilish texnologiyasi (Face-ID), elektron grafik imzo yoki mobil telefon raqamiga SMS-xabar bilan yuboriladigan maxsus kodni maʼlum qilish) orqali uni tasdiqlaydi.</div></div><div class="ACT_TEXT"><div name="-8029882" id="-8029882">13. Quyidagi hollarda savolnomani oʻtkazish toʻxtatiladi:</div></div><div class="ACT_TEXT"><div name="-8029883" id="-8029883">savolnomani tasdiqlash ariza beruvchi tomonidan rad etilganda;</div></div><div class="ACT_TEXT"><div name="-8029884" id="-8029884">ariza beruvchi vafot etganda;</div></div><div class="ACT_TEXT"><div name="-8029885" id="-8029885">ariza beruvchi doimiy yashash uchun Oʻzbekiston Respublikasining boshqa hududiga yoki Oʻzbekiston Respublikasidan tashqariga koʻchib ketganda;</div></div><div class="ACT_TEXT"><div name="-8029886" id="-8029886">ijtimoiy xodim savolnomani toʻldirish uchun borganda ariza beruvchi yashash joyida boʻlmasligi natijasida savolnoma oʻtkazish imkoni boʻlmaganda.</div></div><div class="ACT_TEXT"><div name="-8029887" id="-8029887">Mazkur bandda belgilangan asoslar aniqlanganda ijtimoiy xodim tomonidan axborot moduli orqali mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030202">4-ilovaga</a> muvofiq shaklda elektron dalolatnoma shakllantiriladi va “mahalla yettiligi”ga yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8029888" id="-8029888">Dalolatnoma “mahalla yettiligi”ning kamida besh nafari aʼzosi tomonidan axborot modulida elektron raqamli imzo bilan tasdiqlanishi lozim, bundan xodim mehnat taʼtilida, vaqtinchalik mehnatga layoqatsiz, lavozimi vakant va qonunchilikda belgilangan boshqa holatlar mustasno. Bunda dalolatnoma uni imzolashda ishtirok etgan “mahalla yettiligi” aʼzolarining koʻpchilik ovozi bilan tasdiqlanganda qonuniy kuchga ega boʻladi.</div></div><div class="ACT_TEXT"><div name="-8029889" id="-8029889">Dalolatnoma tasdiqlangandan soʻng ariza beruvchini Reyestrga kiritish avtomatik tarzda rad etiladi va bu haqida ariza beruvchining arizasida koʻrsatilgan mobil telefon raqamiga rad etish sabablari koʻrsatilgan SMS-xabar yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8029890" id="-8029890">14. Ariza beruvchi tomonidan tasdiqlangan savolnoma axborot modulida avtomatik ravishda “mahalla yettiligi”ga yoʻnaltiriladi.</div></div><div class="ACT_TEXT"><div name="-8029891" id="-8029891">15. “Mahalla yettiligi” savolnomadagi maʼlumotlar asosida u kelib tushgandan soʻng uch ish kuni ichida mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030206">5-ilovaga</a> muvofiq shakldagi xulosani tasdiqlaydi.</div></div><div class="ACT_TEXT"><div name="-8029892" id="-8029892">Ariza beruvchi yoki uning oila aʼzolarida norasmiy daromad, mol-mulk mavjudligi yoki norasmiy bandligi boʻyicha maʼlumotlar yoki oilani Reyestrga kiritishni rad etishga asos boʻladigan boshqa holatlar aniqlangan taqdirda xulosa savolnomaga asosan shakllangan maʼlumotlarga tegishli oʻzgartirish kiritish orqali tasdiqlanadi. Bunda har bir kiritilayotgan oʻzgartirishga asos boʻlgan holatlar xulosada qayd etiladi.</div></div><div class="ACT_TEXT"><div name="-8029893" id="-8029893">Xulosani tasdiqlash mazkur Nizomning 13-bandi <a href="https://lex.uz/uz/docs/-8027513#-8029888">yettinchi xatboshisida </a>belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029894" id="-8029894">Xulosa “mahalla yettiligi” aʼzolari tomonidan mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8029891">birinchi xatboshisida </a>belgilangan muddatda tasdiqlanmagan hollarda axborot modulida avtomatik tarzda tasdiqlanadi. Bunda “mahalla yettiligi”ning xulosani tasdiqlamagan aʼzolari yuzaga kelishi mumkin boʻlgan oqibatlar uchun javobgar hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8029895" id="-8029895">16. Xulosa “mahalla yettiligi” tomonidan tasdiqlangandan soʻng oilaning ijtimoiy-iqtisodiy holatini yakuniy baholashdan oʻtkazish uchun avtomatik tarzda “YAMIH” ATga yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8029896" id="-8029896">“YAMIH” AT uch ish kuni ichida oilani ijtimoiy-iqtisodiy holatini yakuniy baholashdan oʻtkazadi.</div></div><div class="ACT_TEXT"><div name="-8029897" id="-8029897">Oilaning ijtimoiy-iqtisodiy holatini yakuniy baholash vazirlik va idoralarning axborot tizimlari orqali olingan va oilaning ijtimoiy-iqtisodiy holati boʻyicha xulosa asosida shakllangan oilaning ijtimoiy-iqtisodiy holati toʻgʻrisidagi maʼlumotlarga asosan “YAMIH” ATda avtomatik tarzda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8029898" id="-8029898">17. Yakuniy baholash natijalari boʻyicha axborot modulida oilaning portreti avtomatik ravishda shakllanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8029899" id="-8029899"><b>3-bob. Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromad miqdorini aniqlash</b></div></div><div class="ACT_TEXT"><div name="-8029900" id="-8029900">18. Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromad Reyestrga kirish uchun murojaat qilingan yoki oilaning ijtimoiy-iqtisodiy ahvoli oʻzgarishi qayta oʻrganilayotgan oydan oldingi oygacha boʻlgan oxirgi uch oyi uchun hisoblab chiqilgan barcha oila aʼzolarining daromadi summasini oila tarkibiga kiritiladigan oila aʼzolari soniga va uchga boʻlish orqali aniqlanadi.</div></div><div class="ACT_TEXT"><div name="-8029901" id="-8029901">Oila tarkibiga fuqarolik holati dalolatnomalarini yozish organlarida nikohi qayd etilgan er-xotin (yoki ularning biri) va ular bilan birga yashaydigan va ularning qaramogʻida boʻlgan bolalar (shu jumladan, vasiylikka (homiylikka) olingan bolalar), shuningdek, ota-onalari bilan birga yashaydigan va nikohi qayd etilmagan oilasiga ega boʻlmagan 18 yoshdan katta farzandlar (shu jumladan, vasiylikka (homiylikka) olingan bolalar) kiritiladi. Bunda toʻliq davlat taʼminotidagi bolalar, tarbiyalash uchun oilaga qabul qilingan (patronat tartibida) bolalar, ota-onalik huquqidan mahrum etilgan, shuningdek, sud qaroriga asosan bedarak yoʻqolgan deb topilgan shaxslar yoki rasman nikohi bekor qilinmagan aliment toʻlash majburiyati belgilangan er (xotin) oila tarkibiga kiritilmaydi.</div></div><div class="BY_DEFAULT"><div name="-8255642" id="-8255642"></div></div><div class="ACT_TEXT"><div name="-8255643" id="-8255643">Ijtimoiy iqtisodiy holati oʻrganilayotgan davrda umumiy roʻzgʻor asosida yashayotgan turmush oʻrtogʻi boʻlmagan boquvchisini yoʻqotganlik pensiyasi yoki nafaqasini olayotgan yoxud bolasi uchun aliment olayotgan ona (ota)ning oilasi boquvchisini yoʻqotgan yoki bolasini yolgʻiz tarbiyalayotgan oila sifatida qabul qilinadi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8255653" id="-8255653">(18-bandning uchinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 21-maydagi 271-sonli <a href="https://lex.uz/uz/docs/-8218769?ONDATE=22.05.2026 00#-8229501">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 22.05.2026-y., 09/26/271/0529-son)</div></div><div class="ACT_TEXT"><div name="-8029903" id="-8029903">19. Bir oylik jami oʻrtacha daromad miqdorini hisoblab chiqishda inobatga olinadigan oilaning jami daromadiga oila tomonidan olingan quyidagi daromadlar kiritiladi:</div></div><div class="ACT_TEXT"><div name="-8029904" id="-8029904">mehnatga haq toʻlash tarzidagi daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029905" id="-8029905">mulkiy daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029906" id="-8029906">olingan alimentlar. Bunda fuqaro tomonidan toʻlangan alimentlar summasi oilaning jami daromadidan chiqarib tashlanadi;</div></div><div class="ACT_TEXT"><div name="-8029907" id="-8029907">pul tushumlari, shu jumladan, chet elda ishlaydigan yoki chet elda tadbirkorlik va boshqa faoliyatni amalga oshiruvchi oila aʼzolari va boshqalardan olingan pul oʻtkazmalari summasi. Bunda xorijiy valyutada olingan pul oʻtkazmalari Oʻzbekiston Respublikasi Markaziy bankining “YAMIH” AT tomonidan elektron maʼlumot olingan kundagi belgilangan kursi boʻyicha Oʻzbekiston Respublikasining milliy valyutasida hisobga olinadi;</div></div><div class="ACT_TEXT"><div name="-8029908" id="-8029908">qonunchilik hujjatlarida belgilangan tartibda haq toʻlanadigan jamoat ishlarida qatnashganlik uchun shaxsga toʻlangan mehnat haqi;</div></div><div class="ACT_TEXT"><div name="-8029909" id="-8029909">pensiyalar, nafaqalar va boshqa moddiy yordam toʻlovlari, bundan mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029913">20-bandida</a> belgilangan toʻlovlar mustasno;</div></div><div class="ACT_TEXT"><div name="-8029910" id="-8029910">mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029932">21-bandida</a> belgilangan normativ daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029911" id="-8029911">Oʻzbekiston Respublikasi qonunchilik hujjatlarida belgilangan boshqa daromadlar.</div></div><div class="ACT_TEXT"><div name="-8029912" id="-8029912">Mehnatga haq toʻlash tarzidagi daromadlar amalda hisoblangan summa boʻyicha hisobga olinadi (qonunchilik hujjatlarida nazarda tutilgan soliqlar va yigʻimlar chegirib tashlanguniga qadar).</div></div><div class="ACT_TEXT"><div name="-8029913" id="-8029913">20. Quyidagi pensiya, nafaqa, kompensatsiya, stipendiya va boshqa moddiy yordam va boshqa toʻlovlar oilaning bir oylik jami oʻrtacha daromad miqdorini hisoblab chiqishda hisobga olinmaydi:</div></div><div class="ACT_TEXT"><div name="-8029914" id="-8029914">a) nogironlik boʻyicha nafaqa summasi doirasidagi nogironlik hamda boquvchisini yoʻqotganlik pensiyalari;</div></div><div class="ACT_TEXT"><div name="-8029915" id="-8029915">b) quyidagi nafaqalar:</div></div><div class="ACT_TEXT"><div name="-8029916" id="-8029916">bolalar nafaqasi va moddiy yordam;</div></div><div class="ACT_TEXT"><div name="-8029917" id="-8029917">nogironligi boʻlgan 18 yoshgacha bolalarga nogironlik nafaqasi;</div></div><div class="ACT_TEXT"><div name="-8029918" id="-8029918">nogironlik nafaqasi;</div></div><div class="ACT_TEXT"><div name="-8029919" id="-8029919">boquvchisini yoʻqotganlik nafaqasi;</div></div><div class="ACT_TEXT"><div name="-8029920" id="-8029920">parvarishlash nafaqasi;</div></div><div class="ACT_TEXT"><div name="-8029921" id="-8029921">homiladorlik va tugʻish nafaqasi;</div></div><div class="ACT_TEXT"><div name="-8029922" id="-8029922">bola tugʻilganligi hamda dafn etish marosimi uchun nafaqalar;</div></div><div class="ACT_TEXT"><div name="-8029923" id="-8029923">v) quyidagi stipendiyalar:</div></div><div class="ACT_TEXT"><div name="-8029924" id="-8029924">taʼlim muassasalari tomonidan toʻlanadigan stipendiyalar;</div></div><div class="ACT_TEXT"><div name="-8029925" id="-8029925">mehnat organlarining yoʻllanmasi boʻyicha kasbga tayyorlash, qayta tayyorlash yoki malaka oshirish davrida toʻlangan stipendiyalar;</div></div><div class="ACT_TEXT"><div name="-8029926" id="-8029926">g) quyidagi moddiy yordam va kompensatsiyalar:</div></div><div class="ACT_TEXT"><div name="-8029927" id="-8029927">Oʻzbekiston Respublikasi Prezidentining Farmon va qarorlari yoki Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarorlari bilan ajratiladigan bir martalik moddiy yordam va pul mukofotlari tarzidagi toʻlovlar;</div></div><div class="ACT_TEXT"><div name="-8029928" id="-8029928">mehnat organlari tomonidan ishsiz fuqarolarga tayinlanadigan va toʻlanadigan moddiy yordam;</div></div><div class="ACT_TEXT"><div name="-8029929" id="-8029929">rasmiy band boʻlgan yolgʻiz ota (ona)larga farzandi uch yoshga toʻlguniga qadar maktabgacha taʼlim xizmatidan foydalanish uchun toʻlanadigan moddiy yordam;</div></div><div class="ACT_TEXT"><div name="-8029930" id="-8029930">elektr energiyasi va tabiiy gaz isteʼmoli uchun bazaviy meʼyor doirasidagi hamda bazaviy meʼyordan oshgan narxlar oʻrtasidagi farq uchun toʻlangan kompensatsiyalar;</div></div><div class="ACT_TEXT"><div name="-8029931" id="-8029931">d) qonunchilikda belgilangan tartibda ajratiladigan subsidiya, ssuda, grant, kreditlar.</div></div><div class="ACT_TEXT"><div name="-8029932" id="-8029932">21. Oila aʼzosining rasmiy maʼlumotlar orqali tasdiqlash imkoni boʻlmagan mehnat faoliyati va mol-mulkidan olingan daromadlariga nisbatan quyidagicha normativ daromad hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-8029933" id="-8029933">ariza beruvchi va oila aʼzosining har bir faoliyat yuritayotgan korxona ustav fondidagi ulushi uchun hisoblanadigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029934" id="-8029934">yakka tartibdagi tadbirkorlik faoliyati bilan shugʻullanuvchi va oʻzini oʻzi band qilgan fuqarolarga hisoblanadigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029935" id="-8029935">rasmiy daromad manbalariga ega boʻlmagan va oxirgi olti oy mobaynida ish izlab mehnat organlariga murojaat qilmagan hamda hisobda turmagan, oʻzini oʻzi band qilgan shaxslar roʻyxatiga kiritilmagan (roʻyxatga kiritilgan lekin ijtimoiy soliq toʻlamagan) yoki haq toʻlanadigan jamoat ishlari ishtirokchisi hisoblanmagan, chet elda ishlamaydigan yoki tadbirkorlik va boshqa faoliyatni amalga oshirmaydigan norasmiy mehnat faoliyati bilan shugʻullanayotgan oila aʼzosiga hisoblanadigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029936" id="-8029936">chet elda ishlaydigan yoki chet elda tadbirkorlik va boshqa faoliyat turini amalga oshiruvchi oila aʼzosiga hisoblanadigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029937" id="-8029937">tomorqa yer va/yoki dehqon xoʻjaligini yuritishdan olingan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029938" id="-8029938">chorva mollari va parrandalari mavjud boʻlgan fuqarolarga hisoblanadigan normativ daromad.</div></div><div class="ACT_TEXT"><div name="-8029939" id="-8029939">Oilaning har bir aʼzosiga toʻgʻri keladigan jami oʻrtacha oylik daromadini aniqlashda tegishli oila aʼzosiga ushbu bandda koʻrsatilgan bir oylik normativ daromadlar uch oyga koʻpaytirilgan holda hisob-kitob qilinadi.</div></div><div class="ACT_TEXT"><div name="-8029940" id="-8029940">22. Ariza beruvchi va oila aʼzosining har bir faoliyat yuritayotgan korxona ustav fondidagi ulushining Markaziy bankning amalda boʻlgan qayta moliyalashtirish stavkasi asosida foiz hisobida bir oylik davr uchun hisoblanadigan qiymatiga teng, lekin mehnatga haq toʻlash eng kam miqdorining ikki baravaridan kam boʻlmagan miqdorda bir oylik normativ daromad qoʻllaniladi.</div></div><div class="ACT_TEXT"><div name="-8029941" id="-8029941">23. Oilaning oʻzini oʻzi band qilgan aʼzosiga mehnatga haq toʻlash eng kam miqdoriga nisbatan quyidagi miqdorlarda bir oylik normativ daromad hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-8029942" id="-8029942">a) erkaklar uchun:</div></div><div class="ACT_TEXT"><div name="-8029943" id="-8029943">Toshkent shahrida 2,7 baravar;</div></div><div class="ACT_TEXT"><div name="-8029944" id="-8029944">Nukus shahri va viloyat markazlarida 2,4 baravar;</div></div><div class="ACT_TEXT"><div name="-8029945" id="-8029945">boshqa shaharlarda 2,1 baravar;</div></div><div class="ACT_TEXT"><div name="-8029946" id="-8029946">boshqa maʼmuriy-hududiy birliklarda 1,8 baravar;</div></div><div class="ACT_TEXT"><div name="-8029947" id="-8029947">b) ayollar uchun:</div></div><div class="ACT_TEXT"><div name="-8029948" id="-8029948">Toshkent shahrida 2,3 baravar;</div></div><div class="ACT_TEXT"><div name="-8029949" id="-8029949">Nukus shahri va viloyat markazlarida 2 baravar;</div></div><div class="ACT_TEXT"><div name="-8029950" id="-8029950">boshqa shaharlarda 1,7 baravar;</div></div><div class="ACT_TEXT"><div name="-8029951" id="-8029951">boshqa maʼmuriy-hududiy birliklarda 1,4 baravar.</div></div><div class="ACT_TEXT"><div name="-8029952" id="-8029952">Fuqarolar Soliq qoʻmitasining “YAMIH” AT tomonidan elektron soʻrov yuborilgan kunda oʻzini oʻzi band qilgan shaxslar tomonidan mehnat staji hisoblanishi uchun qonunchilik hujjatlarida belgilangan (toʻliq) miqdorda ijtimoiy soliq toʻlanganda oʻzini oʻzi band qilgan shaxs sifatida hisobga olinadi.</div></div><div class="ACT_TEXT"><div name="-8029953" id="-8029953">24. Yakka tartibdagi tadbirkorlik va yakka tartibdagi tadbirkorning yollangan xodimi faoliyatidan olingan daromadni aniqlashda oxirgi uch oy davomida toʻlangan aylanmadan olinadigan soliq summasi oʻrtacha miqdorining ikki yarim baravariga teng boʻlgan, biroq oʻzini oʻzi band qilgan shaxslarga hisoblanadigan normativ daromaddan kam boʻlmagan normativ daromad hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8029954" id="-8029954">25. Rasmiy daromad manbalariga ega boʻlmagan va oxirgi olti oy mobaynida ish izlab mehnat organlariga murojaat qilmagan hamda hisobda turmagan, yakka tartibdagi tadbirkorlik faoliyati bilan shugʻullanuvchi yoki oʻzini oʻzi band qilgan shaxslar roʻyxatiga kiritilmagan (roʻyxatga kiritilgan lekin ijtimoiy soliq toʻliq toʻlamagan) yoxud haq toʻlanadigan jamoat ishlari ishtirokchisi hisoblanmagan, chet elda ishlamaydigan yoki tadbirkorlik va boshqa faoliyatni amalga oshirmaydigan norasmiy mehnat faoliyati bilan shugʻullanayotgan mehnatga layoqatli oila aʼzosiga oʻzini oʻzi band qilgan shaxslar uchun belgilangan normativ daromadlar miqdoriga nisbatan 5 foiz koʻpaytiruvchi koeffitsiyent qoʻllanilgan holda normativ daromad hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8029955" id="-8029955">26. Chet elda ishlaydigan yoki chet elda tadbirkorlik va boshqa faoliyat turini amalga oshiruvchi oila aʼzolaridan pul oʻtkazmalari miqdori aniqlanmasa yoki oʻtkazmalar miqdori mehnatga haq toʻlash eng kam miqdorining ikki baravari miqdoridan kam boʻlsa, u holda oilaning bir oylik jami oʻrtacha daromadini aniqlashda quyidagicha normativ daromad qoʻllaniladi:</div></div><div class="ACT_TEXT"><div name="-8029956" id="-8029956">mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030211">6-ilovadagi</a> roʻyxatga kiritilgan mamlakatlardagi faoliyati uchun — mehnatga haq toʻlash eng kam miqdorining uch baravari miqdorida;</div></div><div class="ACT_TEXT"><div name="-8029957" id="-8029957">boshqa davlatdagi shaxslar uchun — mehnatga haq toʻlash eng kam miqdorining ikki baravari miqdorida.</div></div><div class="ACT_TEXT"><div name="-8029958" id="-8029958">Bunda Oʻzbekiston Respublikasi Ichki ishlar vazirligining tegishli axborot tizimidan olingan maʼlumotlarda ariza berilgan sanadan kamida uch oy avval Oʻzbekiston Respublikasidan chiqib ketgan va Oʻzbekiston Respublikasiga qaytmaganligi qayd etilgan fuqaro chet elda ishlaydigan yoki chet elda tadbirkorlik va boshqa faoliyatni amalga oshiruvchi shaxs sifatida qabul qilinadi.</div></div><div class="ACT_TEXT"><div name="-8029959" id="-8029959">27. Ariza beruvchiga va uning aʼzolariga tegishli yoki ularning foydalanuvidagi yakka tartibda uy-joy qurish uchun ajratilgan yer uchastkasining tomorqa maydonini hisoblash Urbanizatsiya va uy-joy bozorini barqaror rivojlantirish milliy qoʻmitasi huzuridagi Kadastr agentligining axborot tizimidan elektron axborot almashinuvi hamda oilaning ijtimoiy-iqtisodiy holati boʻyicha jamlangan maʼlumotlar asosida kuyidagi formuladan foydalangan holda amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-8029960" id="-8029960">TEM = UM — QM — (UM × 20%), bunda:</div></div><div class="ACT_TEXT"><div name="-8029961" id="-8029961">TEM — tomorqa yer va/yoki dehqon xoʻjaligi maydoni;</div></div><div class="ACT_TEXT"><div name="-8029962" id="-8029962">UM — ajratilgan yerning umumiy maydoni (m<sup>2</sup>);</div></div><div class="ACT_TEXT"><div name="-8029963" id="-8029963">QM — qurilishlarning maydoni (m<sup>2</sup>);</div></div><div class="ACT_TEXT"><div name="-8029964" id="-8029964">(UM × 20 %) koʻrsatkichi 200 metr kvadratdan oshmagan holda hisob-kitob uchun qabul qilinadi.</div></div><div class="ACT_TEXT"><div name="-8029965" id="-8029965">Tomorqa yer va/yoki dehqon xoʻjaligini yuritishdan olingan daromad miqdori sifatida ushbu bandda belgilangan tomorqa yer va/yoki dehqon xoʻjaligini yuritishdan olinadigan daromadning normativ miqdori qabul qilinadi.</div></div><div class="ACT_TEXT"><div name="-8029966" id="-8029966">Tomorqa yer va/yoki dehqon xoʻjaligini yuritishdan olinadigan bir oylik oʻrtacha normativ daromad tomorqa yer va/yoki dehqon xoʻjaligini yuritish uchun foydalanilayotgan sotixlar maydonini jami daromad aniqlanayotgan davrda belgilangan mehnatga haq toʻlash eng kam miqdorining 0,035 baravarini jismoniy shaxslarning turar joy obyektlariga har bir mahalla uchun xalq deputatlari kengashi tomonidan tasdiqlangan yer soligʻi koeffitsiyentiga koʻpaytirish yoʻli bilan aniqlanadi. Bunda bir mahalla ikki va undan ortiq zonalarga boʻlingan boʻlsa eng kam koeffitsiyenti hisobga olinadi.</div></div><div class="ACT_TEXT"><div name="-8029967" id="-8029967">28. Chorva mollari va parrandalari mavjud boʻlgan ariza beruvchi va uning oila aʼzolarining bir oylik oʻrtacha normativ daromadini hisoblashda:</div></div><div class="ACT_TEXT"><div name="-8029968" id="-8029968">chorva mollari va parrandalarning soni shartli bosh qoramol soniga Vazirlar Mahkamasining 2019-yil 19-avgustdagi 689-son qarori bilan tasdiqlangan Yaylovlarda chorva mollarini oʻtlatishda eng koʻp yoʻl qoʻyiladigan foydalanish normalarini belgilash, yaylovlar almashinishini taʼminlash va yuritish tartibi toʻgʻrisidagi nizomga 5-ilovada keltirilgan Chorva mollarini va parrandalarni shartli boshga oʻgirish <a href="https://lex.uz/uz/docs/-4477902#-4482428">koeffitsiyentiga</a> asosan oʻtkaziladi. Bunda echki uchun shartli bosh hisoblashda 0,07 koeffitsiyent qoʻllanadi;</div></div><div class="ACT_TEXT"><div name="-8029969" id="-8029969">har bir shartli bosh qoramol sonini daromad aniqlanayotgan davrda mehnatga haq toʻlashning eng kam miqdorining 0,5 baravariga koʻpaytirish yoʻli bilan hisoblab chiqariladi. Bunda dastlabki bir shartli bosh qoramol uchun normativ daromad qoʻllanmaydi.</div></div><div class="ACT_TEXT"><div name="-8029970" id="-8029970">29. Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik oʻrtacha jami daromad miqdori quyidagi formula asosida aniqlanadi:</div></div><div class="ACT_TEXT"><div name="-8029971" id="-8029971">BOOʻD — (MHTD+MD+OA-TA+TU+JIMH+YTTND+POʻ+PN+QP+TD+CHM+BD+NBSHND)/OAS/3 bunda:</div></div><div class="ACT_TEXT"><div name="-8029972" id="-8029972">BOOʻD — oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik oʻrtacha jami daromad;</div></div><div class="ACT_TEXT"><div name="-8029973" id="-8029973">MHTD — mehnatga haq toʻlash tarzidagi daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029974" id="-8029974">MD — mulkiy daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029975" id="-8029975">OA — oila aʼzolari tomonidan olingan alimentlar;</div></div><div class="ACT_TEXT"><div name="-8029976" id="-8029976">TA — oila aʼzolari tomonidan toʻlangan alimentlar;</div></div><div class="ACT_TEXT"><div name="-8029977" id="-8029977">TU — tashkilot taʼsischisiga qoʻllaniladigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029978" id="-8029978">JIMH — qonunchilik hujjatlarida belgilangan tartibda haq toʻlanadigan jamoat ishlarida qatnashganlik uchun shaxsga toʻlangan mehnat haqi;</div></div><div class="ACT_TEXT"><div name="-8029979" id="-8029979">YTTND — yakka tartibdagi tadbirkorlik faoliyati bilan shugʻullanuvchi va oʻzini oʻzi band qilgan fuqarolar uchun hisoblanadigan normativ daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029980" id="-8029980">POʻ — pul oʻtkazmalari, shu jumladan, chet elda ishlaydigan yoki chet elda tadbirkorlik va boshqa faoliyatni amalga oshiruvchi oila aʼzolaridan pul oʻtkazmalari summasi yoki ularga hisoblanadigan normativ daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029981" id="-8029981">PN — pensiya va nafaqalar koʻrinishidagi daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029982" id="-8029982">QP — qayta tiklanuvchi energiya manbalari qurilmalari tomonidan ishlab chiqarilgan elektr energiyasini sotganligi uchun toʻlangan subsidiya;</div></div><div class="ACT_TEXT"><div name="-8029983" id="-8029983">TD — tomorqa yer va/yoki dehqon xoʻjaligini yuritishdan hisoblanadigan normativ daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029984" id="-8029984">CHM — chorva mollari va parrandalari mavjud boʻlgan fuqarolarga hisoblanadigan normativ daromad;</div></div><div class="ACT_TEXT"><div name="-8029985" id="-8029985">BD — oila aʼzolarining boshqa daromadlari;</div></div><div class="ACT_TEXT"><div name="-8029986" id="-8029986">NBSHND — norasmiy band shaxslar uchun hisoblanadigan normativ daromadlar;</div></div><div class="ACT_TEXT"><div name="-8029987" id="-8029987">OAS — oila aʼzolari soni.</div></div><div class="ACT_TEXT"><div name="-8029988" id="-8029988">Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromad miqdorini hisoblashda mazkur bandda nazarda tutilgan turdagi mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029900">18-bandida</a> belgilangan muddatlarda olingan daromadlar inobatga olinadi.</div></div><div class="ACT_TEXT"><div name="-8029989" id="-8029989">30. Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadni hisoblab chiqishning misoli:</div></div><div class="ACT_TEXT"><div name="-8029990" id="-8029990">5 kishidan iborat oilaning aʼzosi Reyestrga kiritish boʻyicha 2025-yil sentabr oyida murojaat qilgan. Uning daromadlari may — iyul oylari uchun hisoblanadi. Oila aʼzolarining barcha daromadlari yigʻindisi (normativ daromadlarni hisobga olgan holda) 6 480 000 soʻmni tashkil etadi.</div></div><div class="ACT_TEXT"><div name="-8029991" id="-8029991">Oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi quyidagini tashkil etadi: 6 480 000 soʻm ÷ 5 (oila aʼzolari soni) ÷ 3 oy = 432 000 soʻm.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8029992" id="-8029992"><b>4-bob. Oilalarni Reyestrga kiritish tartibi</b></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8029993" id="-8029993"><b>1-§. Oilalarni davlat taʼminotidagi oila yoki kambagʻal oila deb topish</b></div></div><div class="ACT_TEXT"><div name="-8029994" id="-8029994">31. Reyestrga oilalar “davlat taʼminotidagi oila”, “kambagʻal oila” va “kambagʻallik chegarasidagi oila” toifalariga ajratilgan holda kiritiladi.</div></div><div class="ACT_TEXT"><div name="-8029995" id="-8029995">32. Oilani mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029997">33-bandida</a> nazarda tutilgan “davlat taʼminotidagi oila” va “kambagʻal oila” deb eʼtirof etishni rad etishga asos boʻladigan holatlar aniqlanmaganda oila “davlat taʼminotidagi oila” yoki “kambagʻal oila” deb eʼtirof etiladi.</div></div><div class="ACT_TEXT"><div name="-8029997" id="-8029997">33. Quyidagi holatlardan kamida bittasi aniqlanganda oilani “davlat taʼminotidagi oila” va “kambagʻal oila” deb topish rad etiladi:</div></div><div class="ACT_TEXT"><div name="-8029998" id="-8029998">a) oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi minimal isteʼmol xarajatlari miqdoridan yuqori boʻlganda. Bunda minimal isteʼmol xarajatlari miqdorining yangi miqdori eʼlon qilinganida oilaning daromadlari “davlat taʼminotidagi oila” yoki “kambagʻal oila” toifasidagi mezonlariga muvofiqligini aniqlash minimal isteʼmol xarajatlari miqdori oʻzgargan oydan keyingi oyning birinchi sanasidan boshlab yangi miqdorlarda aniqlanadi;</div></div><div class="ACT_TEXT"><div name="-8029999" id="-8029999">b) quyidagi holatlardan kamida bittasi aniqlanganda:</div></div><div class="ACT_TEXT"><div name="-8030000" id="-8030000">Koʻchmas mulk obyektlariga boʻlgan huquqlarning davlat reyestrida oila aʼzolariga tegishli jami bittadan ortiq koʻchmas mulk va yer uchastkasi yoki bir va undan ortiq noturar joylari mavjud boʻlganda;</div></div><div class="ACT_TEXT"><div name="-8030001" id="-8030001">ariza beruvchi yoki uning oila aʼzolarining foydalanuvida boʻlgan daromad olib keluvchi bir va undan ortiq noturar joylar boʻlganda;</div></div><div class="ACT_TEXT"><div name="-8030002" id="-8030002">v) qonunchilik hujjatlarida belgilangan tartibda oila aʼzolari nomiga rasmiylashtirilgan yoki ularning foydalanuvida boʻlgan yoxud ishonchnomaga asosan quyidagilardan kamida bittasi mavjud boʻlganda:</div></div><div class="ACT_TEXT"><div name="-8030003" id="-8030003">ishlab chiqarilgan muddati 12 (oila aʼzosi bolalikdan nogironligi boʻlgan bola, I yoki II guruh nogironligi boʻlgan shaxs boʻlsa — 7 yil) yildan oshmagan, texnik holati soz boʻlgan va qidiruvda boʻlmagan yengil avtotransport vositasi;</div></div><div class="ACT_TEXT"><div name="-8030004" id="-8030004">ishlab chiqarilgan muddati 15 yildan oshmagan, texnik holati soz boʻlgan va qidiruvda boʻlmagan yuk tashuvchi avtotransport vositasi, avtobus, mikroavtobus, ekskavator, traktor, kombayn, yuk tashuvchi avtotransport vositalarining tirkamalari va yarim tirkamalari, avtokran va boshqa qurilish texnikasi;</div></div><div class="ACT_TEXT"><div name="-8030005" id="-8030005">jami ikki va undan ortiq, texnik holati soz boʻlgan yengil va yuk tashuvchi avtotransport vositalari, mikroavtobus, ekskavator, traktor, kombayn, yuk tashuvchi avtotransport vositalarining tirkamalari va yarim tirkamalari, avtokran va boshqa qurilish texnikasi;</div></div><div class="ACT_TEXT"><div name="-8030006" id="-8030006">g) oila aʼzolarining tijorat banklaridagi depozit hisobvaraqlarida ariza berilgan oyda amalda boʻlgan mehnatga haq toʻlash eng kam miqdorining besh baravari va undan ortiq miqdorda mablagʻlari mavjud boʻlganda;</div></div><div class="ACT_TEXT"><div name="-8030007" id="-8030007">d) oila aʼzolarida ariza berilgan oyda bozor qiymati mehnatga haq toʻlash eng kam miqdorining besh baravari va undan ortiq summani tashkil etuvchi qimmatli qogʻozlar mavjud boʻlganda;</div></div><div class="ACT_TEXT"><div name="-8030008" id="-8030008">e) Oʻzbekiston Respublikasi Mudofaa vazirligi, Ichki ishlar vazirligi, Favqulodda vaziyatlar vazirligi, Oʻzbekiston Respublikasi Prezidenti Davlat xavfsizlik xizmati, Milliy gvardiya, Davlat xavfsizlik xizmati, Iqtisodiyot va moliya vazirligi huzuridagi Bojxona qoʻmitasi, Mudofaa vazirligi huzuridagi Mudofaa sanoati agentligi hamda ularning tizimidagi tashkilotlarning xizmatchilari va xodimlari yoki ularning oila aʼzolari (eri (xotini) va bolalari), shuningdek, pensionerlari tomonidan arizalar taqdim etilganda. Bunda mazkur talablar ish haqi toʻgʻrisida maʼlumotlari Soliq qoʻmitasining fuqarolar ish haqining yakka tartibdagi hisobini yuritishning markazlashtirilgan elektron reyestrida mavjud boʻlgan hamda mehnat yoki fuqarolik-huquqiy shartnomalari “Yagona milliy mehnat tizimi” idoralararo dasturiy-apparat kompleksida hisobga qoʻyilgan shaxslarga nisbatan tatbiq etilmaydi;</div></div><div class="ACT_TEXT"><div name="-8030009" id="-8030009">j) oila aʼzosi Vazirlar Mahkamasining 2019-yil 9-yanvardagi 11-son qarori bilan tasdiqlangan Sudyalar va ularning oila aʼzolari pensiya taʼminoti shartlari, meʼyorlari hamda tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-4154314#-4157296">nizomga </a>asosan pensiyalar bilan taʼminlanganda;</div></div><div class="ACT_TEXT"><div name="-8030010" id="-8030010">z) oila doimiy yashash uchun Oʻzbekiston Respublikasi hududidan tashqariga koʻchib ketganda;</div></div><div class="ACT_TEXT"><div name="-8030011" id="-8030011">i) yolgʻiz yashovchi yoki yolgʻiz shaxs sodir etgan jinoyati uchun ozodlikdan mahrum etilganda;</div></div><div class="BY_DEFAULT"><div name="-8255658" id="-8255658"></div></div><div class="ACT_TEXT"><div name="-8255662" id="-8255662">k) yolgʻiz yashovchi yoki yolgʻiz keksa va nogironligi boʻlgan shaxs Ijtimoiy qoʻllab-quvvatlash markazlari yoki “Gʻamxoʻrlik” markazlariga joylashtirilganda;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8255667" id="-8255667">(33-bandning “k” kichik bandi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 21-maydagi 271-sonli <a href="https://lex.uz/uz/docs/-8218769?ONDATE=22.05.2026 00#-8229503">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 22.05.2026-y., 09/26/271/0529-son)</div></div><div class="ACT_TEXT"><div name="-8030013" id="-8030013">l) savolnoma oʻtkazish mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029882">13-bandida</a> belgilangan asoslarga koʻra toʻxtatilganda;</div></div><div class="ACT_TEXT"><div name="-8030014" id="-8030014">m) mazkur Nizomning 5-bandi <a href="https://lex.uz/uz/docs/-8027513#-8029864">toʻrtinchi xatboshisiga </a>rioya qilmagan holda murojaat qilinganda;</div></div><div class="ACT_TEXT"><div name="-8030015" id="-8030015">n) ariza beruvchi vafot etganda.</div></div><div class="ACT_TEXT"><div name="-8030019" id="-8030019">Mazkur bandda nazarda tutilmagan asoslar boʻyicha oilani davlat taʼminotidagi va kambagʻal oila deb topishni rad etishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030046" id="-8030046">“Davlat taʼminotidagi oila” va “kambagʻal oila” deb topish rad etilgan oilani Reyestrga kiritish quyidagi hollarda avtomatik ravishda rad etiladi:</div></div><div class="ACT_TEXT"><div name="-8030062" id="-8030062">mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8029998">“a” kichik bandiga</a> asosan rad etilgan oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi minimal isteʼmol xarajatlarining ikki baravaridan yuqori boʻlsa;</div></div><div class="ACT_TEXT"><div name="-8030090" id="-8030090">mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8029999">“b” — “n” kichik bandlariga</a> asosan rad etilganda.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030096" id="-8030096"><b>2-§. Ogʻir hayotiy vaziyatga tushgan oilalarni Reyestrga kiritish</b></div></div><div class="ACT_TEXT"><div name="-8030097" id="-8030097">34. Mazkur Nizomning 33-bandi <a href="https://lex.uz/uz/docs/-8027513#-8029998">“a” kichik bandiga</a> asosan “davlat taʼminotidagi oila” va “kambagʻal oila” deb topish rad etilgan va daromadiga 25 foiz kamaytiruvchi koeffitsiyent qoʻllaganda har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi minimal isteʼmol xarajatlari miqdorining bir yarim baravaridan oshmaydigan quyidagi oilalarga “mahalla yettiligi” oʻttiz kun ichida ogʻir hayotiy vaziyatga tushgan oila sifatida “kambagʻallik chegarasidagi oila” toifasiga kiritish toʻgʻrisida tavsiya berishi mumkin:</div></div><div class="ACT_TEXT"><div name="-8030098" id="-8030098">I va (yoki) II guruh nogironligi boʻlgan shaxs yoxud bolalikdan nogironligi boʻlgan shaxs bor oila;</div></div><div class="ACT_TEXT"><div name="-8030099" id="-8030099">boquvchisini yoʻqotgan yoki bolasini yolgʻiz tarbiyalayotgan oila;</div></div><div class="ACT_TEXT"><div name="-8030100" id="-8030100">oʻzgalar parvarishiga muhtoj boʻlgan yolgʻiz yashovchi hamda yolgʻiz shaxs;</div></div><div class="ACT_TEXT"><div name="-8030101" id="-8030101">oila aʼzosi muddatli harbiy xizmatda yoki jazoni ijro etish muassasasida boʻlgan oila;</div></div><div class="ACT_TEXT"><div name="-8030102" id="-8030102">oila aʼzosi psixiatriya, narkologiya, sil kasalliklari dispanserida boʻlgan yoki onkologiya markazlarida roʻyxatda boʻlgan yoxud gematologiya, immunologiya, jigar, buyrak yetishmovchiligi kabi ogʻir kasallikka chalingan oila aʼzosi mavjud oila;</div></div><div class="ACT_TEXT"><div name="-8030103" id="-8030103">yongʻin, baxtsiz hodisa, tabiiy yoki texnogen favqulodda vaziyatlardan jabrlangan oila.</div></div><div class="ACT_TEXT"><div name="-8030104" id="-8030104">Oila aʼzosining mazkur bandning <a href="https://lex.uz/uz/docs/-8027513#-8030098">ikkinchi — toʻrtinchi xatboshisida</a> nazarda tutilgan talablarga muvofiqligi hamda Oʻzbekiston Respublikasi hududidagi jazoni ijro etish muassasasida saqlanayotganligi idoralararo elektron hamkorlik orqali avtomatik tarzda aniqlanadi.</div></div><div class="ACT_TEXT"><div name="-8030105" id="-8030105">“Mahalla yettiligi”ning tavsiyasi mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030218">7-ilovaga</a> muvofiq shaklda ijtimoiy xodim tomonidan axborot modulida shakllantiriladi va mazkur Nizomning 13-bandi <a href="https://lex.uz/uz/docs/-8027513#-8029888">yettinchi xatboshisida</a> belgilangan tartibda tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8030106" id="-8030106">“Mahalla yettiligi” “kambagʻallik chegarasidagi oila” toifasiga ogʻir hayotiy vaziyatga tushgan oila sifatida bir kalendar yil davomida tasdiqlangan tavsiyasi soni Oʻzbekiston Respublikasi Prezidentining “Ijtimoiy himoyaga muhtoj aholi qatlamlariga davlat ijtimoiy qoʻllab-quvvatlash choralarini taqdim etish tizimini tubdan takomillashtirish chora-tadbirlari toʻgʻrisida” 2025-yil 26-dekabrdagi PF-258-son Farmonga <a href="https://lex.uz/uz/docs/-7952180#-7957281">1-ilovada</a> belgilangan miqdorlardan koʻp boʻlmasligi lozim.</div></div><div class="ACT_TEXT"><div name="-8030107" id="-8030107">35. “Mahalla yettiligi” tomonidan tavsiya berilgan oila Reyestrning “kambagʻallik chegarasidagi oila” toifasiga kiritiladi. Bunda dastlabki baholash natijasi boʻyicha oilani “davlat taʼminotidagi oila” va “kambagʻal oila” deb topish rad etilgan boʻlsa:</div></div><div class="ACT_TEXT"><div name="-8030108" id="-8030108">a) oilaning ijtimoiy-iqtisodiy holati mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029880">11 — 17-bandlarida </a>belgilangan tartibda baholashdan oʻtkaziladi;</div></div><div class="ACT_TEXT"><div name="-8030109" id="-8030109">b) baholash natijasi boʻyicha oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi 25 foiz kamaytiruvchi koeffitsiyent qoʻllagan holda hisoblangandan keyin:</div></div><div class="ACT_TEXT"><div name="-8030110" id="-8030110">minimal isteʼmol xarajatlari miqdorining bir yarim baravaridan oshmasa, oila “kambagʻallik chegarasidagi oila” toifasiga kiritiladi;</div></div><div class="ACT_TEXT"><div name="-8030111" id="-8030111">minimal isteʼmol xarajatlari miqdorining bir yarim baravaridan oshsa, oilaga berilgan tavsiya avtomatik ravishda bekor boʻladi.</div></div><div class="ACT_TEXT"><div name="-8030112" id="-8030112">Tavsiya berilgan sanada mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8029900">18-bandiga </a>muvofiq baholash uchun inobatga olinadigan muddat oʻtkazib yuborilgan boʻlsa, oilaning ijtimoiy-iqtisodiy holati avtomatik tarzda baholashdan oʻtkaziladi.</div></div><div class="ACT_TEXT"><div name="-8030113" id="-8030113">Oila yashaydigan mahallada belgilangan miqdordagi oilalar ogʻir hayotiy vaziyatga tushgan oila sifatida “kambagʻallik chegarasidagi oila” toifasiga kiritilgan boʻlsa, oila ogʻir hayotiy vaziyatga tushgan oila toifasiga mos kelmasa, oʻttiz kun ichida oilaga tavsiya berilmasa yoki berilgan tavsiya bekor boʻlgan boʻlsa oilalarni Reyestrga kiritish avtomatik tarzda rad etiladi.</div></div><div class="ACT_TEXT"><div name="-8030114" id="-8030114">Oila tavsiya asosida “kambagʻallik chegarasidagi oila” toifasiga kiritilgandan soʻng xulosa oʻz kuchini yoʻqotadi.</div></div><div class="ACT_TEXT"><div name="-8030115" id="-8030115">36. Oila Reyestrga kiritilganda oila aʼzosining qonunchilikda belgilangan tartibda qilgan murojaatiga asosan mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030222">8-ilovaga</a> muvofiq shakldagi maʼlumotnoma taqdim etiladi.</div></div><div class="ACT_TEXT"><div name="-8030116" id="-8030116">“Ijtimoiy reyestr”ga kiritilgan oilalarga individual reja ishlab chiqish va uning ijrosini taʼminlash tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8027513#-8030234">nizomda </a>belgilangan tartibda oilalarni ijtimoiy-iqtisodiy holatini yaxshilash boʻyicha individual reja ishlab chiqiladi.</div></div><div class="ACT_TEXT"><div name="-8030117" id="-8030117">37. Oilaning Reyestrga kiritilganligi yoki Reyestrga kiritish rad etilganligi haqida ariza beruvchining mobil telefon raqamiga SMS-xabar yuboriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030118" id="-8030118"><b>5-bob. Oilalarni toifalarga ajratish tartibi</b></div></div><div class="ACT_TEXT"><div name="-8030119" id="-8030119">38. Reyestrga kiritilgan oilaning toifasi uning portretida qayd etilgan maʼlumotlarga muvofiq axborot modulida avtomatik tarzda belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8030120" id="-8030120">39. Oilalar Reyestrda quyidagi toifalarga ajratiladi:</div></div><div class="ACT_TEXT"><div name="-8030121" id="-8030121">a) “davlat taʼminotidagi oila” toifasiga — oila aʼzolari mehnatga layoqatsiz yoki mehnat qilish imkoniyati cheklangan va ularning har biriga toʻgʻri keladigan jami oʻrtacha oylik daromadi minimal isteʼmol xarajatlaridan kam boʻlgan Oʻzbekiston Respublikasi Prezidentining “Ijtimoiy himoyaga muhtoj aholi qatlamlariga davlat ijtimoiy qoʻllab-quvvatlash choralarini taqdim etish tizimini tubdan takomillashtirish chora-tadbirlari toʻgʻrisida” 2025-yil 26-dekabrdagi PF-258-son Farmoniga <a href="https://lex.uz/uz/docs/-7952180#-7957281">1-ilovada</a> belgilangan toifadagi oilalar;</div></div><div class="ACT_TEXT"><div name="-8030122" id="-8030122">b) “kambagʻal oila” toifasiga — oila aʼzolari mehnatga layoqatli yoki mehnat qilish imkoniyatiga ega boʻlgan va ularning har biriga toʻgʻri keladigan jami oʻrtacha oylik daromadi minimal isteʼmol xarajatlaridan kam boʻlgan oilalar;</div></div><div class="ACT_TEXT"><div name="-8030123" id="-8030123">v) “kambagʻallik chegarasidagi oila” toifasiga — oila aʼzolarining har biriga toʻgʻri keladigan jami oʻrtacha oylik daromadi minimal isteʼmol xarajatlarining bir baravaridan bir yarim baravarigacha boʻlgan quyidagi oilalar:</div></div><div class="ACT_TEXT"><div name="-8030124" id="-8030124">“davlat taʼminotidagi oila” yoki “kambagʻal oila” oila toifalaridan chiqarilgan oilalar;</div></div><div class="ACT_TEXT"><div name="-8030125" id="-8030125">mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030097">34-bandiga </a>muvofiq “mahalla yettiligi”ning tavsiyasi asosida Reyestrga kiritilgan ogʻir hayotiy vaziyatga tushgan oilalar.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030126" id="-8030126"><b>6-bob. Reyestrga kiritilgan oilalarni qayta baholashdan oʻtkazish, toifasini oʻzgartirish va Reyestrdan chiqarish tartibi</b></div></div><div class="ACT_TEXT"><div name="-8030127" id="-8030127">40. Reyestrga kiritilgan oilalarning ijtimoiy-iqtisodiy holatini qayta baholashdan oʻtkazish ular Reyestrda turgan davrida vazirlik va idoralarning axborot tizimlariga elektron soʻrov yuborish orqali olingan va xulosada shakllangan maʼlumotlarga asosan har oyda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8030128" id="-8030128">Oilalar ular Reyestrga kiritilgan kundan boshlab quyidagi muddatlarda oila aʼzolari ishtirokida savolnoma qayta toʻldiriladi:</div></div><div class="ACT_TEXT"><div name="-8030129" id="-8030129">“davlat taʼminotidagi oila” — har oʻn ikki oyda;</div></div><div class="ACT_TEXT"><div name="-8030130" id="-8030130">“kambagʻal oila” — har olti oyda.</div></div><div class="ACT_TEXT"><div name="-8030131" id="-8030131">Bunda qayta baholash savolnomaga muvofiq shakllangan “mahalla yettiligi”ning xulosasi hamda vazirlik va idoralarning axborot tizimlariga elektron soʻrov yuborish orqali olingan maʼlumotlarga asosan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8030132" id="-8030132">41. Qayta baholash natijalari boʻyicha oilaning toifasini oʻzgartirish uchun asoslar aniqlanganda oilaning toifasi avtomatik tarzda oʻzgartiriladi hamda bu haqida ariza beruvchining mobil telefon raqamiga SMS-xabar yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8030133" id="-8030133">42. Oilalar quyidagi hollarda Reyestrdan chiqariladi:</div></div><div class="ACT_TEXT"><div name="-8030134" id="-8030134">qayta baholash natijasiga koʻra oilaning har bir aʼzosiga toʻgʻri keladigan bir oylik jami oʻrtacha daromadi minimal isteʼmol xarajatlari miqdorining bir yarim baravaridan oshganligi aniqlanganda. Bunda ogʻir hayotiy vaziyatga tushgan oila sifatida “kambagʻallik chegarasidagi oila” toifasiga kiritilgan oilalarning bir oylik jami oʻrtacha daromadini hisoblashda 25 foiz kamaytiruvchi koeffitsiyent inobatga olinadi;</div></div><div class="ACT_TEXT"><div name="-8030135" id="-8030135">qayta baholash natijasiga koʻra mazkur Nizomning 33-bandi <a href="https://lex.uz/uz/docs/-8027513#-8029999">“b” — “n” kichik bandlarida</a> belgilangan asoslar aniqlanganda;</div></div><div class="ACT_TEXT"><div name="-8030136" id="-8030136">“kambagʻallik chegarasidagi oila” mazkur toifaga kiritilganligiga (oʻtkazilganligiga) oʻn ikki oy toʻlgan boʻlsa;</div></div><div class="ACT_TEXT"><div name="-8030137" id="-8030137">oilaning barcha aʼzolari, shu jumladan, yolgʻiz yashovchi yoki yolgʻiz shaxs vafot etgan taqdirda;</div></div><div class="ACT_TEXT"><div name="-8030138" id="-8030138">oilaning muomalaga layoqatli aʼzosi mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030226">9-ilovadagi</a> shaklga muvofiq Reyestrdan chiqarishni soʻrab murojaat qilganda;</div></div><div class="ACT_TEXT"><div name="-8030139" id="-8030139">axborot modulida texnik nosozlik natijasida, maʼlumotlar elektron ravishda toʻliq yoki qisman taqdim etilmaganligi sababli, shuningdek, savolnoma toʻldirishda texnik xatolar oqibatida oila Reyestrga notoʻgʻri kiritilganligi aniqlanganda;</div></div><div class="ACT_TEXT"><div name="-8030140" id="-8030140">Reyestrga kiritish toʻgʻrisidagi qarorga taʼsir koʻrsatgan ariza beruvchi, “mahalla yettiligi” yoki boshqa davlat organi tomonidan notoʻgʻri va ishonchsiz maʼlumotlar taqdim etilganligi yoki toʻliq taqdim etilmaganligi aniqlanganda.</div></div><div class="ACT_TEXT"><div name="-8030141" id="-8030141">Oilani Reyestrdan chiqarish toʻgʻrisidagi ariza oilaning muomalaga layoqatli aʼzosi tomonidan davlat xizmatlari markaziga borgan holda yoki YIDXP yoxud “Ijtimoiy karta” mobil ilovasi orqali mustaqil ravishda taqdim etiladi.</div></div><div class="ACT_TEXT"><div name="-8030142" id="-8030142">Oilalarni mazkur bandda nazarda tutilmagan asoslarga koʻra Reyestrdan chiqarishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030143" id="-8030143">43. Reyestrga kiritilgan oilalar qonunchilikda nazarda tutilgan davlat ijtimoiy qoʻllab-quvvatlash choralaridan foydalanadi.</div></div><div class="ACT_TEXT"><div name="-8030144" id="-8030144">“Kambagʻallik chegarasidagi oila” toifasiga kiritilgan oilalar avval belgilangan toifasiga muvofiq, ogʻir hayotiy vaziyatga tushgan oilalar kambagʻal oilalar uchun nazarda tutilgan davlat ijtimoiy qoʻllab-quvvatlash choralaridan foydalanadi. Bunda ogʻir hayotiy vaziyatga tushgan oilalar davlat ijtimoiy qoʻllab-quvvatlash choralaridan ular “kambagʻallik chegarasidagi oila” toifasiga kiritilgan (oʻtkazilgan) paytdan boshlab oʻn ikki oy davomida foydalanadi.</div></div><div class="ACT_TEXT"><div name="-8030145" id="-8030145">44. Oilaning toifasi oʻzgarganligi yoki Reyestrdan chiqarilganligi haqida ariza beruvchining mobil telefon raqamiga SMS-xabar yuboriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030146" id="-8030146"><b>7-bob. Yakunlovchi qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8030147" id="-8030147">45. Manfaatdor vazirliklar va idoralarning axborot tizimlaridan ariza beruvchi toʻgʻrisida elektron shaklda avtomatlashtirilgan tarzda olingan maʼlumotlar “Shaxsga doir maʼlumotlar toʻgʻrisida”gi Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-4396419">Qonuniga </a>muvofiq himoyalanadi.</div></div><div class="ACT_TEXT"><div name="-8030148" id="-8030148">“YAMIH” ATda ishlashga ruxsat berilgan davlat organlari, tashkilot va idoralar oʻz faoliyatini amalga oshirish natijasida olingan shaxsga doir maʼlumotlarning sir saqlanishini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-8030149" id="-8030149">46. Quyidagilar uchun:</div></div><div class="ACT_TEXT"><div name="-8030150" id="-8030150">oila tarkibi, ijtimoiy holati, yashash joyining oʻzgarishi va oilaning chorva mollari va parrandalari hamda arizachi va uning oila aʼzolari nomiga rasmiylashtirilmagan biroq foydalanuvida boʻlgan avtotransport vositalari, noturar binolari, koʻchmas mulklari, bogʻ va dehqon xoʻjalik yerlari mavjudligi toʻgʻrisidagi axborotning ishonchliligi va oʻzgarishlar toʻgʻrisidagi maʼlumotlarni vakolatli organini oʻz vaqtida xabardor qilish boʻyicha — ariza beruvchiga;</div></div><div class="ACT_TEXT"><div name="-8030151" id="-8030151">ariza beruvchining har qanday maʼlumotlarini Reyestrga mazkur Nizom talablariga muvofiq hamda oʻz vaqtida kiritish boʻyicha — ijtimoiy xodimga;</div></div><div class="ACT_TEXT"><div name="-8030152" id="-8030152">savolnomani oʻtkazish, xulosani tasdiqlash, ogʻir hayotiy vaziyatga tushgan oilaga tavsiya berish boʻyicha — “mahalla yettiligi”ga;</div></div><div class="ACT_TEXT"><div name="-8030153" id="-8030153">Reyestr va “YAMIH” ATni qonunchilik va texnik hujjatlari talablariga muvofiq toʻgʻri ishlashini taʼminlash, axborot modulini takomillashtirib borish, axborot moduli foydalanuvchilariga login va parol ochish (yopish), vazirlik va idoralarning axborot tizimlari bilan maʼlumot almashishini taʼminlash va yoʻlga qoʻyish boʻyicha — Ijtimoiy himoya milliy agentligi (keyingi oʻrinlarda — Agentlik) huzuridagi “Axborot texnologiyalar markazi” davlat muassasasi masʼullariga;</div></div><div class="ACT_TEXT"><div name="-8030154" id="-8030154">ariza beruvchi va uning oilasining ijtimoiy-iqtisodiy holatini oʻrganish uchun “YAMIH” AT orqali yuborilgan elektron soʻrovlarga oʻz vaqtida va toʻgʻri (ishonchli) maʼlumotlarni elektron ravishda onlayn rejimida taqdim etilishi boʻyicha — manfaatdor vazirlik va idoralar rahbarlariga shaxsiy javobgarlik yuklanadi.</div></div><div class="ACT_TEXT"><div name="-8030155" id="-8030155">47. Mazkur Nizom qoidalari asosida ariza beruvchi va uning oilasini Reyestrga kiritish bilan bogʻliq barcha davlat xizmatlari bepul amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8030156" id="-8030156">48. Manfaatdor vazirlik va idoralarning axborot tizimlari oʻrtasidagi maʼlumotlar almashinuvi jarayonida texnik nosozliklar va uzilishlar yuzaga kelgan yoki elektron maʼlumotlarni toʻliq olinmagan hollarda, Agentlikka alohida axborot tizimlaridagi maʼlumot almashinuvini tegishli tizimlar toʻlaqonli qayta ishga tushgunga qadar vaqtinchalik toʻxtatish hamda oilaning toifasini avtomatik tarzda aniqlash algoritmiga oʻzgartirish kiritish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-8030157" id="-8030157">49. Mazkur Nizomda belgilangan talablarga rioya etilishi Oʻzbekiston Respublikasi Bosh prokuraturasi, Agentlikning ichki audit xizmati hamda Ijtimoiy inspeksiya tomonidan nazorat qilib boriladi.</div></div><div class="ACT_TEXT"><div name="-8030158" id="-8030158">50. Oilani “davlat taʼminotidagi oila”, “kambagʻal oila” va “kambagʻallik chegarasidagi oila” deb eʼtirof etish, Reyestrga kiritish, toifasini belgilash, qayta baholashdan oʻtkazish va Reyestrdan chiqarish boʻyicha nizolar tuman (shahar) hokimliklari huzurida tashkil etiladigan apellyatsiya kengashlari va boshqa qonunchilik hujjatlarida belgilangan tartibda hal etiladi.</div></div><div class="ACT_TEXT"><div name="-8030159" id="-8030159">51. Ariza beruvchi Reyestrni yuritish boʻyicha davlat xizmatlarini koʻrsatuvchi davlat organlari va boshqa tashkilotlar xodimlarining noqonuniy xatti-harakatlari yuzasidan qonunchilik hujjatlarida belgilangan tartibda shikoyat qilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030160" id="-8030160">52. Mazkur Nizom talablari buzilishida aybdor boʻlgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javob beradilar.</div></div><div class="BY_DEFAULT"><div name="-8030161" id="-8030161"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8030162" id="-8030162">Ijtimoiy reyestrni yuritish tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8027513#-8029846">nizomga</a><br />1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8030163" id="-8030163"><b>Oilalarni Ijtimoiy reyestrga kiritish</b></div></div><div class="ACT_FORM"><div name="-8030164" id="-8030164">SXEMASI</div></div><div class="BY_DEFAULT"><div name="-8030165" id="-8030165"></div></div><div class="TABLE_STD2"><div name="-8035593" id="-8035593"><table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse" width="100%"><tbody><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Bosqichlar</b></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:14.96%;border:solid windowtext 1.0pt;border-left:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Subyektlar</b></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:50.0%;border:solid windowtext 1.0pt;border-left:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p align="center" style="text-align:center"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Mexanizm</b></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:18.18%;border:solid windowtext 1.0pt;border-left:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Bajarish muddatlari</b></p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">1-bosqich</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:14.96%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">Ariza beruvchi</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:50.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">Oilasini Ijtimoiy Reyestr (keyingi oʻrinlarda — Reyestr)ga kiritishni soʻrab ijtimoiy xodim, davlat xizmatlari markazi, “Inson” ijtimoiy xizmatlar markazi, “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi oʻrinlarda — “YAMIH” AT), Yagona interaktiv davlat xizmatlari portali (keyingi oʻrinlarda — YIDXP) yoki “Ijtimoiy karta” mobil ilovasi orqali ariza bilan murojaat qiladi.</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:18.18%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">Xohishiga koʻra</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td rowspan="3" style="width:10.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">2-bosqich</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="3" style="width:14.96%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">“YAMIH” AT</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">1. Ariza beruvchi oilasini ijtimoiy-iqtisodiy holatini elektron hamkorlik orqali dastlabki tarzda baholashdan oʻtkazadi.</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">1. Ariza kelib tushganidan soʻng uch kun ichida</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">2. Ariza beruvchi oilasining ijtimoiy-iqtisodiy holati davlat taʼminotidagi yoki kambagʻal oilalar uchun belgilangan mezonlarga mos boʻlganda murojaat ariza beruvchi yashaydigan mahallaga biriktirilgan ijtimoiy xodimning shaxsiy kabinetiga yoʻnaltiriladi.</p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">2. Avtomatik tarzda</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">3. Ariza beruvchi oilasining ijtimoiy-iqtisodiy holati Reyestrga kiritish uchun belgilangan mezonlarga mos boʻlmaganda Reyestrga kiritish rad etiladi va ariza beruvchining mobil aloqa vositasiga SMS-xabar yuboradi.</p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">3. Avtomatik tarzda</p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">3-bosqich</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:14.96%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">Ijtimoiy xodim</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">1. Oilaning muomalaga layoqatli aʼzosi ishtirokida savolnomani toʻldiradi.</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">1. Ariza kelib tushganidan soʻng uch ish kuni ichida</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif">2. Ariza beruvchi savolnomani oʻtkazishga rozilik berganda uni imzolarni identifikatsiya qilishning tegishli vositalari (shaxsning yuzini biometrik identifikatsiya qilish texnologiyasi (Face-ID), elektron grafik imzo yoki mobil telefon raqamiga SMS-xabar bilan yuboriladigan maxsus kodni maʼlum qilish) orqali tasdiqlaydi.</p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">2. Avtomatik tarzda</p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.18%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">4-bosqich</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:14.96%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">“Mahalla yettiligi”</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:50.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><div style="border-top:none;border-left:solid windowtext 1.0pt;border-bottom:  none;border-right:solid windowtext 1.0pt;padding:0in 4.0pt 0in 4.0pt"><p style="text-align:justify;text-indent:13.1pt;border:none;padding:0in;font-size:12.0pt;font-family:"Times New Roman",serif">1. Savolnomadagi maʼlumotlar asosida xulosani axborot modulida elektron raqamli imzo bilan tasdiqlaydi.</p><p style="text-align:justify;text-indent:13.1pt;border:none;padding:0in;font-size:12.0pt;font-family:"Times New Roman",serif">2. Tasdiqlangan xulosa maxsus baholashdan oʻtkazish uchun “YAMIH” ATga yuboradi.</p></div></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:18.18%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">Uch ish kuni ichida</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:50.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="50%"><p style="text-align:justify;text-indent:13.1pt;font-size:12.0pt;font-family:  "Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"