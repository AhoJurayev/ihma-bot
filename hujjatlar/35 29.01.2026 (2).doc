0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">1. Avtomatik ravishda</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:47.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="47%"><p style="text-align:justify;text-indent:8.5pt;line-height:  normal;font-size:12.0pt;font-family:"Times New Roman",serif">2. Ariza beruvchilarning arizasida koʻrsatilgan mobil aloqa vositasiga SMS-xabar ijtimoiy nafaqa tayinlanganligi yoki tayinlash rad egilganligi toʻgʻrisida xabar yuboradi.</p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">2. Avtomatik ravishda</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:47.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="47%"><p style="text-align:justify;text-indent:8.5pt;line-height:  normal;font-size:12.0pt;font-family:"Times New Roman",serif">3. Bolalar nafaqasi yoki moddiy yordamni toʻlash boʻyicha elektron hujjatlarni shakllantiradi va moliyaviy agentga yuboradi.</p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:18.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" valign="top" width="18%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">3. Toʻlov amalga oshiriladigan oyning 4-sanasiga qadar</p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" st