;height:14.2pt" width="18%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">4-bosqich</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:17.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="17%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">Moliyaviy agent</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:47.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="47%"><p style="text-align:justify;text-indent:8.5pt;line-height:  normal;font-size:12.0pt;font-family:"Times New Roman",serif">1. Bolalar nafaqasi va moddiy yordam oluvchilarga toʻlovlarni amalga oshiradi.</p><p style="text-align:justify;text-indent:8.5pt;line-height:  normal;font-size:12.0pt;font-family:"Times New Roman",serif">2. “Inson” ijtimoiy xizmatlar markaziga ijtimoiy nafaqa toʻlovlari toʻgʻrisida maʼlumot taqdim etadi.</p><p style="text-align:justify;text-indent:8.5pt;line-height:  normal;font-size:12.0pt;font-family:"Times New Roman",serif">3. Toʻlanmagan mablagʻlarni Oʻzbekiston Respublikasining respublika budjetiga qaytaradi va vakolatli organga maʼlumot taqdim etadi.</p></td><td style="width:1.0%;border-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:18.0%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">Toʻlov amalga oshiriladigan oyning 5 — 27-sanasi davomida</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 3.0pt 0in 3.0pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr></tbody></table></div></div><div class="BY_DEFAULT"><div name="-8030429" id="-8030429"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8030430" id="-8030430">Ijtimoiy reyestrga kiritilgan oilalarga bolalar nafaqasi va moddiy yordamni tayinlash va toʻlash tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8027513#-8030310">nizomga</a><br />2-ILOVA</div></div><div class="BY_DEFAULT"><div name="-8030431" id="-8030431"></div></div><div class="TABLE_STD2"><div name="-8035668" id="-8035668"><table class="Table" style="width: 730px;border-collapse: collapse" width="100%"><tbody><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p align="right" style="text-align:right"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">NAMUNA</span></span></b></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">_________________ “Inson” ijtimoiy xizmatlar</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td style="width: 166px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><sup><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">tuman (shahar)</span></span></sup></span></span></span></p></td><td style="width: 162px;padding: 0cm 4px;height: 19px"><p></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">markazining direktoriga</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Quyidagi manzilda yashaydigan fuqaro</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Mahalla ____________________________________</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">koʻcha (kvartal) _______________________________</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Uy _________________________________________</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Kvartira ___________________________________</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">__________________________________ tomonidan</span></span></span></span></span></p></td></tr><tr><td style="width: 347px;padding: 0cm 4px;height: 19px"><p style="text-align:justify"></p></td><td colspan="2" style="width: 363px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><sup><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(ariza beruvchining F.I.O)</span></span></sup></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ARIZA</span></span></b></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p align="center" style="text-align:center"></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Sizdan mening oilamga qonunchilikda belgilangan ijtimoiy nafaqa (bolalari nafaqasi yoki moddiy yordam) tayinlashingizni soʻrayman.</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Arizani koʻrib chiqish toʻgʻrisidagi xabarni quyida keltirilgan telefon raqamiga: +998________________ yoki elektron pochta ____________________ga yuborishingizni soʻrayman.</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">“Inson” ijtimoiy xizmatlar markazini oila tarkibi (bola tugʻilganligi, vafot etganligi yoki boshqa holatlar), yashash joyim oʻzgarganligi va nafaqa (moddiy yordam) miqdoriga taʼsir koʻrsatuvchi boshqa holatlar yoki oʻzgarishlar sodir boʻlganda oʻz vaqtida xabardor qilish majburiyatini olaman.</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Mening va oila aʼzolarim toʻgʻrisidagi maʼlumotlar axborot tizimlari orqali tekshirilishiga hamda tayinlangan nafaqa toʻlovini bank kartasi yoki ijtimoiy karta orqali amalga oshirilishiga rozilik beraman.</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Murojaat qiluvchining imzosi: ___________________________</span></span></span></span></span></p></td></tr><tr><td colspan="3" style="width: 718px;padding: 0cm 4px;height: 19px"><p style="text-align:justify;text-indent:14.2pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Arial,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Sana: 20____ yil “____” _________________</span></span></span></span></span></p></td></tr></tbody></table></div></div><div class="BY_DEFAULT"><div name="-8030433" id="-8030433"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8030434" id="-8030434">Vazirlar Mahkamasining 2026-yil 29-yanvardagi 35-son <a href="https://lex.uz/uz/docs/-8027513">qaroriga</a><br />4-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8030435" id="-8030435"><b>Tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlari toʻgʻrisida</b></div></div><div class="ACT_FORM"><div name="-8030436" id="-8030436">NIZOM</div></div><div class="BY_DEFAULT"><div name="-8030437" id="-8030437"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030438" id="-8030438"><b>1-bob. Umumiy qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8030439" id="-8030439">1. Mazkur Nizom tuman (shahar) hokimliklari huzuridagi Ijtimoiy reyestrni (keyingi oʻrinlarda — Reyestr) yuritishga doir nizolarni hal qilish boʻyicha apellyatsiya kengashlarining (keyingi oʻrinlarda — Apellyatsiya kengashlari) maqomi, asosiy vazifalari, huquq va majburiyatlari, shuningdek, faoliyatini tashkil etish tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-8030440" id="-8030440">2. Apellyatsiya kengashlari tuman (shahar) hokimliklari huzurida nizolarni hal qilish maqsadida tuziladigan kollegial-maslahat organi hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8030441" id="-8030441">Apellyatsiya kengashi aʼzolari oʻz faoliyatini doimiy ravishda amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8030442" id="-8030442">3. Mazkur Nizomda quyidagi asosiy tushunchalardan foydalaniladi:</div></div><div class="ACT_TEXT"><div name="-8030443" id="-8030443"><strong>manfaatdor shaxs</strong> — huquqlari va qonuniy manfaatlari tegishli “mahalla yettiligi” tomonidan qabul qilingan maʼmuriy hujjatga bevosita daxldor boʻlgan jismoniy shaxs;</div></div><div class="ACT_TEXT"><div name="-8030444" id="-8030444"><strong>shikoyat</strong> — manfaatdor shaxs yoki uning vakili tomonidan tegishli “mahalla yettiligi” tomonidan qabul qilgan maʼmuriy hujjatlari ustidan yoʻllangan shikoyat.</div></div><div class="ACT_TEXT"><div name="-8030445" id="-8030445">4. Apellyatsiya kengashlari oʻz faoliyatini Oʻzbekiston Respublikasining xalqaro shartnomalari, Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasi</a> va qonunlariga, Oʻzbekiston Respublikasi Oliy Majlisi palatalarining qarorlariga, Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlariga, Vazirlar Mahkamasining qarorlari va farmoyishlariga, shuningdek, ushbu Nizomga va boshqa qonunchilik hujjatlariga muvofiq amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8030446" id="-8030446">5. Apellyatsiya kengashlari oʻz faoliyatini davlat organlari, boshqa tashkilotlar va mansabdor shaxslardan mustaqil ravishda amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8030447" id="-8030447">6. Apellyatsiya kengashlari tomonidan shikoyatlarni koʻrib chiqqanlik uchun toʻlovlar undirilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030448" id="-8030448">7. Manfaatdor shaxslar tomonidan apellyatsiya kengashlariga shikoyat qilish ixtiyoriy boʻlib, bu ularning tegishli davlat organlari va tashkilotlarining yuqori turuvchi organlariga yoki bevosita sudga murojaat qilish huquqini cheklamaydi.</div></div><div class="ACT_TEXT"><div name="-8030449" id="-8030449">8. Sudlarda koʻrib chiqilgan yoki koʻrib chiqilayotgan masalalar boʻyicha yoʻllangan shikoyatlar apellyatsiya kengashlari tomonidan koʻrib chiqilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030450" id="-8030450">9. Apellyatsiya kengashlari murojaatlarni koʻrib chiqishda teng huquqlilik, xolislik, qonuniylik, kollegiallik va huquqni qoʻllash amaliyotining bir xilligini taʼminlash hamda murojaat etuvchilarning huquqlari va qonuniy manfaatlariga rioya qilish prinsiplariga asoslanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030451" id="-8030451"><b>2-bob. Apellyatsiya kengashining asosiy vazifalari</b></div></div><div class="ACT_TEXT"><div name="-8030452" id="-8030452">10. Quyidagilar apellyatsiya kengashlarining asosiy vazifalari hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-8030453" id="-8030453">“mahalla yettiligi”ning mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030510">26-bandida</a> nazarda tutilgan ishlar yuzasidan qabul qilingan maʼmuriy hujjatlarning qonunchilik hujjatlariga muvofiqligini koʻrib chiqish;</div></div><div class="ACT_TEXT"><div name="-8030454" id="-8030454">shikoyatlarni koʻrib chiqishda aniqlangan qonunchilik hujjatlaridagi tafovut va huquqiy boʻshliqlarni bartaraf etish yuzasidan takliflar ishlab chiqish.</div></div><div class="ACT_TEXT"><div name="-8030455" id="-8030455">11. Manfaatdor shaxslarning shikoyatlari apellyatsiya kengashlari tomonidan maʼmuriy tartib-taomillar toʻgʻrisidagi qonunchilikka muvofiq koʻrib chiqiladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030456" id="-8030456"><b>3-bob. Apellyatsiya kengashlarining huquq va majburiyatlari</b></div></div><div class="ACT_TEXT"><div name="-8030457" id="-8030457">12. Apellyatsiya kengashlari quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-8030458" id="-8030458">tegishli “mahalla yettiligi” tomonidan qabul qilgan maʼmuriy hujjatlarning qonunchilik hujjatlariga muvofiqligini koʻrib chiqish natijasiga asosan ushbu maʼmuriy hujjatlarni oʻzgartirish, qisman yoki toʻliq bekor qilish toʻgʻrisida qarorlar qabul qilish;</div></div><div class="ACT_TEXT"><div name="-8030459" id="-8030459">oʻziga yuklangan vazifalarni bajarish uchun zarur boʻlgan hujjatlar va axborotlarni, shuningdek, boshqa asoslovchi maʼlumotlarni respublika ijro etuvchi hokimiyat organlari, uning tizim tashkilotlari va hududiy boʻlinmalari, mahalliy davlat hokimiyati organlari, “mahalla yettiligi” va boshqa tashkilotlardan bepul tarzda soʻrash va olish, bunda “mahalla yettiligi” tomonidan soʻralgan maʼlumotlar besh ish kunidan kechiktirmasdan taqdim etilishi lozim;</div></div><div class="ACT_TEXT"><div name="-8030460" id="-8030460">zarurat boʻlganda, xorijiy mutaxassis va ekspertlarni, shuningdek, davlat organlari, ilmiy va taʼlim muassasalari, nodavlat notijorat tashkilotlardan mutaxassis va ekspertlarni taklif qilish hamda ishchi va ekspert guruhlarini tashkil etish.</div></div><div class="ACT_TEXT"><div name="-8030461" id="-8030461">Apellyatsiya kengashlari qonunchilik hujjatlariga muvofiq boshqa huquqlarga ham ega boʻlishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030462" id="-8030462">13. Apellyatsiya kengashlari quyidagilarga majbur:</div></div><div class="ACT_TEXT"><div name="-8030463" id="-8030463">qonunchilik hujjatlariga va mazkur Nizom talablariga qatʼiy rioya qilish;</div></div><div class="ACT_TEXT"><div name="-8030464" id="-8030464">manfaatdor shaxslarning shaʼni va qadr-qimmatini kamsitishga hamda ularning shaxsiy hayotiga aralashishga yoʻl qoʻymaslik;</div></div><div class="ACT_TEXT"><div name="-8030465" id="-8030465">shikoyatlarning koʻrib chiqilishi natijasi yuzasidan asoslangan qarorlar qabul qilish;</div></div><div class="ACT_TEXT"><div name="-8030466" id="-8030466">maʼmuriy hujjatlarni koʻrib chiqish davomida olingan axborotning, agar bunday axborotni tarqatish qonunchilik hujjatlari bilan cheklangan boʻlsa, sir saqlanishini taʼminlash.</div></div><div class="ACT_TEXT"><div name="-8030467" id="-8030467">Apellyatsiya kengashlariga qonunchilik hujjatlariga muvofiq boshqa majburiyatlar ham yuklanishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030468" id="-8030468"><b>4-bob. Apellyatsiya kengashlari faoliyatini tashkil etish tartibi</b></div></div><div class="ACT_TEXT"><div name="-8030469" id="-8030469">14. Apellyatsiya kengashlarining tarkibi tuman (shahar) hokimi tomonidan mazkur Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030559">1-ilovadagi</a> namunaviy tarkibga muvofiq tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8030470" id="-8030470">15. Apellyatsiya kengashlari tarkibiga tegishliligiga koʻra ularning raisi, kotibi va aʼzolari kiradi. Bunda apellyatsiya kengashlari kotibi ishlarni koʻrib chiqish yakunlari boʻyicha ovoz berishda ishtirok etmaydi.</div></div><div class="ACT_TEXT"><div name="-8030471" id="-8030471">16. Quyidagi holatlarda apellyatsiya kengashlari aʼzolari uning tarkibidan chiqariladi:</div></div><div class="ACT_TEXT"><div name="-8030472" id="-8030472">apellyatsiya kengashlari aʼzosi bilan tuzilgan mehnat shartnomasi bekor qilinganda;</div></div><div class="ACT_TEXT"><div name="-8030473" id="-8030473">ularga nisbatan chiqarilgan sudning ayblov hukmi qonuniy kuchga kirganda;</div></div><div class="ACT_TEXT"><div name="-8030474" id="-8030474">sudning qonuniy kuchga kirgan hal qiluv qarori asosida muomala layoqati cheklanganda, shuningdek, ular muomalaga layoqatsiz, bedarak yoʻqolgan yoki vafot etgan deb topilganda;</div></div><div class="ACT_TEXT"><div name="-8030475" id="-8030475">oʻz arizasiga koʻra (jamoatchilik asosida faoliyat yurituvchi aʼzo uchun);</div></div><div class="ACT_TEXT"><div name="-8030476" id="-8030476">vafot etganda.</div></div><div class="ACT_TEXT"><div name="-8030477" id="-8030477">17. Apellyatsiya kengashlari aʼzolari quyidagi hollarda kun tartibiga kiritilgan masalalar yuzasidan majlisda ishtirok etishi mumkin emas va rad qilinishi lozim, agar ular:</div></div><div class="ACT_TEXT"><div name="-8030478" id="-8030478">maʼmuriy hujjatni koʻrib chiqish natijasidan shaxsan, bevosita yoki bilvosita manfaatdor boʻlsa yoxud uning xolisligi va begʻarazligiga shubha tugʻdiradigan boshqa holatlar mavjud boʻlsa;</div></div><div class="ACT_TEXT"><div name="-8030479" id="-8030479">manfaatdor shaxsning yoki “mahalla yettiligi” aʼzolarining yaqin qarindoshi boʻlsa.</div></div><div class="ACT_TEXT"><div name="-8030480" id="-8030480">Ushbu bandda koʻrsatilgan asoslar mavjud boʻlsa, apellyatsiya kengashlari aʼzosi oʻzini oʻzi rad qilish haqida arz qilishi shart.</div></div><div class="ACT_TEXT"><div name="-8030481" id="-8030481">18. Manfaatdor shaxslar ushbu Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030469">17-bandidagi</a> asoslarga koʻra apellyatsiya kengashlari aʼzosini rad qilish haqida arz qilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030482" id="-8030482">19. Rad qilish haqidagi ariza asoslantirilgan boʻlishi va shikoyatni apellyatsiya kengashlari tomonidan koʻrish boshlanguniga qadar maʼlum qilinishi kerak.</div></div><div class="ACT_TEXT"><div name="-8030483" id="-8030483">Apellyatsiya kengashlari aʼzolarini rad qilish tegishliligiga koʻra apellyatsiya kengashlari raislarining tashabbusiga koʻra ham koʻrib chiqilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030484" id="-8030484">20. Shikoyat koʻrilayotganda rad qilish haqida ariza berishga, agar rad qilish uchun asos ariza bergan shaxsga shikoyatni mazmunan koʻrish boshlanganidan keyin maʼlum boʻlib qolgan taqdirda yoʻl qoʻyiladi.</div></div><div class="ACT_TEXT"><div name="-8030485" id="-8030485">Ayni bir shaxs tomonidan ayni bir asos boʻyicha takroran rad qilish bildirilishi mumkin emas. Takroran rad qilish bildirilgan taqdirda, shikoyat koʻrib chiqilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030486" id="-8030486">21. Apellyatsiya kengashlari aʼzolarining oʻzini oʻzi rad qilishi yoki uni rad qilish toʻgʻrisidagi masala tegishliligiga koʻra apellyatsiya kengashlari raislari tomonidan hal etiladi.</div></div><div class="ACT_TEXT"><div name="-8030487" id="-8030487">22. Apellyatsiya kengashlarining raislari:</div></div><div class="ACT_TEXT"><div name="-8030488" id="-8030488">apellyatsiya kengashlari faoliyatiga rahbarlik qiladi va zimmasiga yuklatilgan vazifalarning bajarilishi uchun shaxsan javobgar hisoblanadi;</div></div><div class="ACT_TEXT"><div name="-8030489" id="-8030489">apellyatsiya kengashlarining majlislarini chaqiradi va ularda raislik qiladi;</div></div><div class="ACT_TEXT"><div name="-8030490" id="-8030490">apellyatsiya kengashlari vakolatiga taalluqli masalalarni koʻrib chiqish uchun kiritadi;</div></div><div class="ACT_TEXT"><div name="-8030491" id="-8030491">davlat organlari, nodavlat notijorat tashkilotlar bilan munosabatlarda apellyatsiya kengashi nomidan ish koʻradi;</div></div><div class="ACT_TEXT"><div name="-8030492" id="-8030492">apellyatsiya kengashlari nomidan qarorlarni, majlislar bayonnomalarini va boshqa hujjatlarni imzolaydi;</div></div><div class="ACT_TEXT"><div name="-8030493" id="-8030493">apellyatsiya kengashlari majlislari kun tartibini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8030494" id="-8030494">apellyatsiya kengashlari tomonidan qabul qilingan qarorlarning ijrosini nazorat qiladi;</div></div><div class="ACT_TEXT"><div name="-8030495" id="-8030495">apellyatsiya kengashlari ishining samaradorligini oshirishga qaratilgan boshqa chora-tadbirlarni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8030496" id="-8030496">23. Apellyatsiya kengashlari raislari boʻlmagan taqdirda, ularning vazifalarini tegishliligiga koʻra apellyatsiya kengashining boshqa aʼzosi bajaradi.</div></div><div class="ACT_TEXT"><div name="-8030497" id="-8030497">24. Apellyatsiya kengashlarining kotiblari:</div></div><div class="ACT_TEXT"><div name="-8030498" id="-8030498">manfaatdor shaxslarning shikoyatlarini ish yurituvga qabul qiladi;</div></div><div class="ACT_TEXT"><div name="-8030499" id="-8030499">apellyatsiya kengashlarining navbatdagi majlisiga barcha zarur materiallarning oʻz vaqtida va sifatli tayyorlanishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8030500" id="-8030500">kun tartibiga muvofiq apellyatsiya kengashlari majlislari oʻtkazilishini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8030501" id="-8030501">apellyatsiya kengashlari majlisi oʻtkaziladigan sana, joy va taklif etiladigan shaxslar roʻyxatini apellyatsiya kengashlarining raislari bilan kelishadi;</div></div><div class="ACT_TEXT"><div name="-8030502" id="-8030502">apellyatsiya kengashlarining aʼzolarini va taklif etilgan shaxslarni apellyatsiya kengashlari majlisi oʻtkaziladigan joy, sana va vaqt haqida yozma yoki elektron shaklda xabardor qiladi;</div></div><div class="ACT_TEXT"><div name="-8030503" id="-8030503">kun tartibidagi masalalarni koʻrib chiqish uchun zarur boʻlgan materiallarni apellyatsiya kengashlari aʼzolariga tarqatadi;</div></div><div class="ACT_TEXT"><div name="-8030504" id="-8030504">apellyatsiya kengashlari majlislari qarorlari va bayonnomalarini rasmiylashtiradi hamda qarorlar nusxalarining apellyatsiya kengashlari aʼzolari hamda boshqa manfaatdor shaxslarga joʻnatilishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8030505" id="-8030505">apellyatsiya kengashlari qarorlarining ijro holatini oʻrganib boradi hamda uning natijalarini apellyatsiya kengashlari majlisida koʻrib chiqish uchun kiritadi;</div></div><div class="ACT_TEXT"><div name="-8030506" id="-8030506">apellyatsiya kengashlarining faoliyatini uslubiy, tashkiliy-huquqiy va tashkiliy-texnik jihatdan taʼminlash boʻyicha apellyatsiya kengashlari raislariga takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8030507" id="-8030507">apellyatsiya kengashlarining zimmasiga yuklangan vazifalarga muvofiq boshqa vakolatlarni amalga oshiradi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030508" id="-8030508"><b>5-bob. Manfaatdor shaxslar tomonidan shikoyat qilish hamda apellyatsiya kengashlari tomonidan shikoyatlarni koʻrib chiqish tartibi</b></div></div><div class="ACT_TEXT"><div name="-8030509" id="-8030509">25. Manfaatdor shaxslar yoki ularning vakillari tomonidan shikoyat qilish hamda ularni apellyatsiya kengashlarida koʻrib chiqish ushbu Nizomga <a href="https://lex.uz/uz/docs/-8027513#-8030569">2-ilovadagi</a> sxemaga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8030510" id="-8030510">26. Apellyatsiya kengashlari tomonidan oilalarni Reyestrga kiritish toʻgʻrisidagi arizalarni koʻrib chiqish jarayonida “mahalla yettiligi” tomonidan rasmiylashtiriladigan savolnoma, xulosa, dalolatnomani qisman yoki toʻliq bekor qilish, ularga oʻzgartirish kiritish boʻyicha “mahalla yettiligi”ga majburiyat yuklash boʻyicha shikoyatlarni koʻrib chiqadi.</div></div><div class="ACT_TEXT"><div name="-8030511" id="-8030511">27. Manfaatdor shaxs yoki uning vakili “Inson” ijtimoiy xizmatlar markazi (keyingi oʻrinlarda — “Inson” markazi) yoki davlat xizmatlari markaziga kelib murojaat qilganda “Inson” markazi xodimi manfaatdor shaxs nomidan, “Yagona milliy ijtimoiy himoya” axborot tizimi (keyingi oʻrinlarda — “YAMIH” AT), Yagona interaktiv davlat xizmatlari portali yoki “Ijtimoiy karta” mobil ilovasi orqali shikoyat qilgan taqdirda esa mustaqil ravishda ushbu Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030575">3-ilovasiga</a> muvofiq namunaviy shakldagi shikoyatni elektron tarzda toʻldiradi va tasdiqlaydi.</div></div><div class="ACT_TEXT"><div name="-8030512" id="-8030512">28. Agar shikoyat manfaatdor shaxsning vakili tomonidan berilgan boʻlsa, shikoyatga ishonchnomaning yoki vakil vakolatlarini tasdiqlovchi boshqa hujjatning koʻchirma nusxasi ilova qilinishi lozim.</div></div><div class="ACT_TEXT"><div name="-8030513" id="-8030513">Shikoyatga boshqa asoslovchi maʼlumotlar va hujjatlar ham ilova qilinishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030514" id="-8030514">29. Shikoyat tasdiqlangandan soʻng real vaqt rejimida tegishli apellyatsiya kengashining kotibiga (keyingi oʻrinlarda — kotib) elektron shaklda yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8030515" id="-8030515">Shikoyatlarni koʻrib chiqish va qaror qabul qilish bilan bogʻliq tartib-taomillar “YAMIH” ATda elektron shaklda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8030516" id="-8030516">30. Kotib manfaatdor shaxsning shikoyatini u kelib tushgan kunda, ish vaqti tugaganidan keyin kelib tushgan boʻlsa, keyingi ish kunida roʻyxatdan oʻtkazadi.</div></div><div class="ACT_TEXT"><div name="-8030517" id="-8030517">Kotib ikki ish kuni ichida kelib tushgan shikoyatdagi maʼlumotlarning toʻgʻriligini, shuningdek, ushbu Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030518">31-bandida</a> nazarda tutilgan talablarga muvofiqligini tekshiradi.</div></div><div class="ACT_TEXT"><div name="-8030518" id="-8030518">31. Quyidagi holatlarda shikoyatlarni koʻrib chiqish apellyatsiya kengashlari tomonidan rad etiladi:</div></div><div class="ACT_TEXT"><div name="-8030519" id="-8030519">shikoyatda koʻtarilgan masalalar (holatlar) sudda koʻrib chiqilgan yoki koʻrib chiqilayotgan boʻlsa;</div></div><div class="ACT_TEXT"><div name="-8030520" id="-8030520">shikoyat mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030510">26-bandida </a>belgilangan apellyatsiya kengashlari tomonidan koʻrib chiqiladigan masalalar doirasiga kirmasa;</div></div><div class="ACT_TEXT"><div name="-8030521" id="-8030521">“mahalla yettiligi” tomonidan tasdiqlangan mazkur Nizomning <a href="https://lex.uz/uz/docs/-8027513#-8030510">26-bandida</a> belgilangan hujjatlar kuchga kirganiga oʻttiz kundan oʻtgan boʻlsa.</div></div><div class="ACT_TEXT"><div name="-8030522" id="-8030522">32. Shikoyat rad etilgan taqdirda, kotib tegishli xulosa tuzadi va xulosa apellyatsiya kengashlari raislari tomonidan tasdiqlanib, manfaatdor shaxs bu haqda bir ish kuni ichida yozma yoki elektron shaklda xabardor qilinadi.</div></div><div class="ACT_TEXT"><div name="-8030523" id="-8030523">33. Shikoyat apellyatsiya kengashlariga kelib tushgan kundan boshlab oʻn besh kun ichida koʻrib chiqiladi.</div></div><div class="ACT_TEXT"><div name="-8030524" id="-8030524">Apellyatsiya kengashlarining majlislari oʻtkaziladigan sana kotibning taklifiga asosan apellyatsiya kengashlari raislari tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8030525" id="-8030525">34. Kotib apellyatsiya kengashlari aʼzolarini, manfaatdor shaxs yoki uning vakilini hamda “mahalla yettiligi”ni apellyatsiya kengashlari majlisi oʻtkaziladigan kundan kamida uch kun oldin majlis oʻtkaziladigan joy, sana va vaqt haqida yozma yoki elektron shaklda xabardor qiladi.</div></div><div class="ACT_TEXT"><div name="-8030526" id="-8030526">35. Apellyatsiya kengashlarining aʼzolari oʻz majlislarida koʻrib chiqiladigan masalalarni muhokama qilish va hal qilishda oʻz vakolatini boshqa shaxslarga oʻtkazish huquqiga ega emas.</div></div><div class="ACT_TEXT"><div name="-8030527" id="-8030527">36. Apellyatsiya kengashlarining majlislari zaruratga koʻra, lekin kamida bir oyda bir marta oʻtkaziladi.</div></div><div class="ACT_TEXT"><div name="-8030528" id="-8030528">Apellyatsiya kengashlarining majlisi, agar unda aʼzolarning yarmidan koʻpi ishtirok etayotgan boʻlsa, vakolatli (kvorum) hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8030529" id="-8030529">Majlisni oʻtkazish uchun kvorum shakllanmagan taqdirda, apellyatsiya kengashlarining yangi majlisi oʻtkaziladigan sana eʼlon qilinadi.</div></div><div class="ACT_TEXT"><div name="-8030530" id="-8030530">37. Apellyatsiya kengashlarining majlislarini ularning raislari olib boradi. Rais ishtirok eta olmagan holatlarda, majlisni tegishliligiga koʻra ularning oʻrinbosarlari olib boradi.</div></div><div class="ACT_TEXT"><div name="-8030531" id="-8030531">Apellyatsiya kengashlarining majlislariga boshqa davlat organlari, nodavlat notijorat tashkilotlar, fuqarolik jamiyati institutlarining vakillari ham taklif etilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030532" id="-8030532">Shikoyatni koʻrib chiqish jarayonida zarurat yuzaga kelganda apellyatsiya kengashlari manfaatdor shaxslarning vajlarini joyiga chiqqan holda oʻrganishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030533" id="-8030533">Apellyatsiya kengashlarining majlislari kengash raisining qaroriga koʻra va manfaatdor shaxsga bu haqda xabar berilgan holda audio va videotasvirga, shuningdek, fotosuratga olinishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030534" id="-8030534">Audio va videoyozuv, fotosuratlar manfaatdor shaxs va “mahalla yettiligi”ga taqdim etilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030535" id="-8030535">38. Apellyatsiya kengashlarining aʼzolari, manfaatdor shaxs yoki uning vakili hamda “mahalla yettiligi”ning aʼzolari majlislarda videokonferensaloqa vositalaridan foydalangan holda ishtirok etishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8030536" id="-8030536">39. Apellyatsiya kengashlari majlisining vaqti va joyi toʻgʻrisida tegishli tartibda xabardor qilingan manfaatdor shaxsning va ishga aloqador boshqa shaxslarning kelmaganligi shikoyatni apellyatsiya kengashlari tomonidan ularning ishtirokisiz koʻrib chiqish uchun toʻsqinlik qilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030537" id="-8030537">40. Apellyatsiya kengashlari oʻz majlislarida manfaatdor shaxsning talablari va eʼtirozlarini asoslovchi holatlar, shuningdek, ishni toʻgʻri hal qilish uchun ahamiyatga ega boʻlgan boshqa holatlar mavjudligi yoki mavjud emasligini aniqlaydi.</div></div><div class="ACT_TEXT"><div name="-8030538" id="-8030538">41. Apellyatsiya kengashlarining qarori majlisda ishtirok etayotgan apellyatsiya kengashlari aʼzolarining oddiy koʻpchilik ovozi bilan qabul qilinadi. Bunda hech bir aʼzo ovoz berishda betaraf qolishga haqli emas.</div></div><div class="ACT_TEXT"><div name="-8030539" id="-8030539">Ovozlar teng boʻlgan hollarda majlisga raislik qiluvchining ovozi hal qiluvchi ovoz hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8030540" id="-8030540">42. Apellyatsiya kengashlarining majlisi yakunlari boʻyicha quyidagi qarorlardan biri rasmiylashtiriladi:</div></div><div class="ACT_TEXT"><div name="-8030541" id="-8030541">maʼmuriy hujjatni oʻzgartirishsiz oʻz kuchida qoldirish;</div></div><div class="ACT_TEXT"><div name="-8030542" id="-8030542">maʼmuriy hujjatga oʻzgartirish kiritish boʻyicha “mahalla yettiligi”ga majburiyat yuklash;</div></div><div class="ACT_TEXT"><div name="-8030543" id="-8030543">maʼmuriy hujjatni qisman yoki toʻliq bekor qilish hamda oilani Reyestrga kiritish toʻgʻrisidagi arizani qayta koʻrib chiqish.</div></div><div class="ACT_TEXT"><div name="-8030544" id="-8030544">Shikoyatni koʻrib chiqish jarayonida oilaning ijtimoiy-iqtisodiy holatini aniqlash uchun vazirlik va idoralarning axborot tizimlari orqali olingan maʼlumotlarda xatolik aniqlanganda apellyatsiya kengashi tegishli vakolatli organga mazkur xatolikni bartaraf etish vazifasini yuklaydi.</div></div><div class="ACT_TEXT"><div name="-8030545" id="-8030545">43. Apellyatsiya kengashlarining qarori majlisda ishtirok etgan barcha aʼzolar tomonidan “YAMIH” ATda elektron shaklda imzolanadi.</div></div><div class="ACT_TEXT"><div name="-8030546" id="-8030546">Qabul qilingan qarorga qoʻshilmagan apellyatsiya kengashlari aʼzosi qarorni imzolab, oʻzining alohida fikrini yozma shaklda taqdim qiladi. Alohida fikr ish materiallariga qoʻshib qoʻyiladi.</div></div><div class="ACT_TEXT"><div name="-8030547" id="-8030547">Bunda apellyatsiya kengashlarining qarorlari “YAMIH” ATda qonunchilikda belgilangan tartibda saqlanadi.</div></div><div class="ACT_TEXT"><div name="-8030548" id="-8030548">44. Apellyatsiya kengashlarining qarorlari uch ish kunidan kechiktirmay manfaatdor shaxslar va tegishli “mahalla yettiligi”ning “YAMIH” ATdagi shaxsiy kabinetiga yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8030549" id="-8030549">45. Apellyatsiya kengashlarining qarorlari ustidan manfaatdor shaxs tomonidan sud tartibida shikoyat qilinishi mumkin, “mahalla yettiligi” uchun esa mazkur qarorlar qatʼiy hisoblanadi va ular tomonidan qaror ustidan shikoyat qilinishi mumkin emas.</div></div><div class="ACT_TEXT"><div name="-8030550" id="-8030550">46. Apellyatsiya kengashlarining majlis bayonnomasi kotib tomonidan imzolanadi va majlisga raislik qiluvchi tomonidan tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8030551" id="-8030551">47. Apellyatsiya kengashlari tomonidan “mahalla yettiligi”ning maʼmuriy hujjatini oʻzgartirish, qisman yoki toʻliq bekor qilish haqida qaror qabul qilingan taqdirda, oilani Reyestrga kiritish boʻyicha taqdim etilgan oxirgi ariza “YAMIH” ATda qayta koʻrib chiqish bosqichiga qaytariladi. Bunda qaror qabul qilingunga qadar oila Reyestrga kiritilgan taqdirda ariza koʻrib chiqish bosqichiga qaytarilmaydi.</div></div><div class="ACT_TEXT"><div name="-8030552" id="-8030552">48. Apellyatsiya kengashlarining maʼmuriy hujjatni oʻzgartirish haqidagi hamda qisman yoki toʻliq bekor qilish haqidagi qaror yuzasidan qayta koʻrib chiqish bosqichiga oʻtgan arizalar uch ish kuni ichida va manfaatdor shaxsdan haq undirilmasdan koʻrib chiqiladi. Bunda “mahalla yettiligi” maʼmuriy hujjatni Ijtimoiy reyestrni yuritish tartibi toʻgʻrisida nizomga muvofiq qayta rasmiylashtiradi va arizani koʻrib chiqishning keyingi bosqichiga yoʻnaltiradi.</div></div><div class="ACT_TEXT"><div name="-8030553" id="-8030553">49. Oilani Reyestrga kiritish boʻyicha arizalar qayta koʻrib chiqilganidan soʻng “mahalla yettiligi” bir ish kuni ichida bu haqda apellyatsiya kengashlarini xabardor qilishi shart.</div></div><div class="ACT_TEXT"><div name="-8030554" id="-8030554">“Mahalla yettiligi” aʼzolari tomonidan apellyatsiya kengashlarining oʻz vakolatlari doirasida qabul qilgan qarorlarining ijrosi taʼminlamaganligi ijtimoiy xizmatlar koʻrsatish sohasidagi qonunchilikni buzish hisoblanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8030555" id="-8030555"><b>6-bob. Yakunlovchi qoidalar</b></div></div><div class="ACT_TEXT"><div name="-8030556" id="-8030556">50. “Mahalla yettiligi” tomonidan manfaatdor shaxsga yetkazilgan zararni qoplash bilan bogʻliq masalalar sud tartibida hal etiladi.</div></div><div class="ACT_TEXT"><div name="-8030557" id="-8030557">51. Apellyatsiya kengashlari tomonidan shikoyatlarni koʻrib chiqish paytida huquqbuzarlik alomatlari mavjudligi aniqlangan taqdirda, ushbu holat majlis bayonnomasida qayd etiladi va tegishli hujjatlar qonunchilik hujjatlarida belgilangan tartibda huquqbuzarlikni koʻrib chiqish vakolatiga ega boʻlgan organlarga “Inson” markazi tomonidan yuboriladi.</div></div><div class="ACT_TEXT"><div name="-8030558" id="-8030558">52. Ushbu Nizom talablarining buzilishida aybdor boʻlgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javob beradilar.</div></div><div class="BY_DEFAULT"><div name="-8030559" id="-8030559"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8030560" id="-8030560">Tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlari toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8027513#-8030435">nizomga</a><br />1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8030561" id="-8030561"><b>Tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlarining</b></div></div><div class="ACT_FORM"><div name="-8030562" id="-8030562">NAMUNAVIY TARKIBI</div></div><div class="BY_DEFAULT"><div name="-8030563" id="-8030563"></div></div><div class="TABLE_STD2"><div name="-8035732" id="-8035732"><table border="0" cellpadding="0" cellspacing="0" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">tuman (shahar) hokimining yoshlar siyosati, ijtimoiy rivojlantirish va maʼnaviy-maʼrifiy ishlar boʻyicha oʻrinbosari, <i>Apellyatsiya kengashi raisi </i></p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">Oʻzbekiston mahallalari uyushmasining tuman (shahar) boʻlimi boshligʻi, <i>Apellyatsiya kengashi raisi oʻrinbosari</i></p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">tuman (shahar) kambagʻallikni qisqartirish va bandlikka koʻmaklashish boʻlimi boshligʻi</p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">tuman (shahar) “Inson” ijtimoiy xizmatlar markazi direktori</p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">Xalq deputatlari tuman (shahar) Kengashi kotibiyati mudiri <i>(jamoatchilik asosida)</i></p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">Oʻzbekiston faxriylarining ijtimoiy faoliyatini qoʻllab-quvvatlash “Nuroniy” jamgʻarmasining tumanlar (shaharlar)dagi boʻlimlari boshligʻi <i>(jamoatchilik asosida)</i></p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">nogironligi boʻlgan shaxslarning jamiyati aʼzosi <i>(jamoatchilik asosida)</i></p></td></tr><tr style="height:.75pt"><td style="width: 145px;padding: 0in 2.85pt;height: 0.75pt" valign="top" width="11%"><p style="text-align:justify;line-height:normal"><i style="font-size:12.0pt;font-family:"Times New Roman",serif">Lavozimiga koʻra</i></p></td><td style="width: 40px;padding: 0in 5.25pt;height: 0.75pt" valign="top" width="3%"><p align="center" style="text-align:center;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">—</p></td><td style="width: 1658px;padding: 0in;height: 0.75pt" valign="top" width="86%"><p style="text-align:justify;line-height:normal;font-size:12.0pt;font-family:"Times New Roman",serif">tuman (shahar) “Inson” ijtimoiy xizmatlar markazi xodimi, <i>Apellyatsiya kengashi kotibi</i></p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="-8030565" id="-8030565"><i>Izoh.</i></div></div><div class="FOOTNOTE"><div name="-8030566" id="-8030566"><i>1. Davlat va jamiyat faoliyatining tarmoqlarida, tadbirkorlik va boshqa xoʻjalik faoliyati sohasida ish tajribasiga, shuningdek, hayotiy tajribaga va aholi oʻrtasida obroʻ-eʼtiborga ega boʻlgan tegishli tuman (shaharda) yashovchi boshqa fuqarolar ham jamoatchilik asosida faoliyat yurituvchi aʼzo sifatida apellyatsiya kengashining tarkibiga kiritiladi.</i></div></div><div class="FOOTNOTE"><div name="-8030567" id="-8030567"><i>2. Apellyatsiya kengashi aʼzolari boshqa ishga oʻtgan taqdirda, uning tarkibiga ushbu lavozimlarga yangi tayinlangan yoki zimmasiga tegishli funksiyalarni bajarish yuklangan shaxslar kiritiladi.</i></div></div><div class="FOOTNOTE"><div name="-8030568" id="-8030568"><i>3. Zaruratga koʻra, Apellyatsiya kengashi faoliyatiga boshqa mutaxassis va ekspertlar jalb etilishi mumkin.</i></div></div><div class="BY_DEFAULT"><div name="-8030569" id="-8030569"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8030570" id="-8030570">Tuman (shahar) hokimliklari huzuridagi nizolarni hal qilish boʻyicha apellyatsiya kengashlari toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-8027513#-8030435">nizomga</a><br />2-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8030571" id="-8030571"><b>Apellyatsiya kengashlariga shikoyat qilish va ularni koʻrib chiqish</b></div></div><div class="ACT_FORM"><div name="-8030572" id="-8030572">SXEMASI</div></div><div class="BY_DEFAULT"><div name="-8030573" id="-8030573"></div></div><div class="TABLE_STD2"><div name="-8035737" id="-8035737"><table border="0" cellpadding="0" cellspacing="0" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr style="height:14.2pt"><td rowspan="2" style="width:10.0%;border:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;line-height:normal"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Bosqichlar</b></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;line-height:normal"><b style="font-size:12.0pt;font-family:"Times New Roman",serif"> </b></p></td><td rowspan="2" style="width:17.0%;border:solid windowtext 1.0pt;border-left:none;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="17%"><p align="center" style="text-align:center;line-height:normal"><b style="font-size:12.0pt;font-family:"Times New Roman",serif">Subyektlar</b></p></td><td style="width:1.0%;border:none;border-right:solid wind