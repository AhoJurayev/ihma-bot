-top:none;border-left:none;border-bottom:  solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td rowspan="2" style="width:18.18%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="18%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif">Uch ish kuni ichida</p></td></tr><tr style="height:14.2pt"><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td></tr><tr style="height:14.2pt"><td style="width:10.0%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="10%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:1.0%;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="1%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></td><td style="width:14.96%;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt;height:14.2pt" width="14%"><p align="center" style="text-align:center;font-size:12.0pt;font-family:"Times New Roman",serif"></p></